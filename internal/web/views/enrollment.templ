package views

// OneTimePingURL is only used on successful creation/import responses. The
// caller owns no-store response headers and supplies a unique input ID.
templ OneTimePingURL(id, pingURL string) {
	<div x-data="{message: ''}">
		<label class="form-label" for={ id }>Ping URL</label>
		<div class="flex flex-col sm:flex-row gap-2">
			<input id={ id } x-ref="pingURL" type="text" readonly value={ pingURL } autocomplete="off" spellcheck="false" class="form-input font-mono text-xs min-w-0" @focus="$el.select()"/>
			<button type="button" class="btn-secondary shrink-0" @click="if (!navigator.clipboard) { $refs.pingURL.focus(); $refs.pingURL.select(); message='URL selected. Use your device’s Copy command.'; } else { navigator.clipboard.writeText($refs.pingURL.value).then(() => message='Ping URL copied.').catch(() => { $refs.pingURL.focus(); $refs.pingURL.select(); message='URL selected. Use your device’s Copy command.'; }); }">Copy URL</button>
		</div>
		<p class="form-hint">Send a POST request to this URL whenever the job completes.</p>
		<p class="text-sm text-muted-light mt-2" role="status" x-text="message"></p>
	</div>
}
