package views

import (
	"fmt"
	"strings"

	"github.com/y0f/asura/internal/storage"
)

type EscalationPolicyListParams struct {
	LayoutParams
	Policies []*storage.EscalationPolicy
	Channels []*storage.NotificationChannel
}

func channelNames(channels []*storage.NotificationChannel, ids []int64) string {
	if len(ids) == 0 {
		return "no channels"
	}
	names := make([]string, 0, len(ids))
	for _, id := range ids {
		names = append(names, channelName(channels, id))
	}
	return strings.Join(names, ", ")
}

templ EscalationPolicyListPage(p EscalationPolicyListParams) {
	@Layout(p.LayoutParams) {
		<div x-data={ escalationXData(p) }>
			@PageHeader(PageHeaderParams{Title: "Escalation Policies", Subtitle: "Notify more channels the longer an incident stays open."}) {
				if p.Can("escalation_policies.write") {
					@ToolbarNewButtonClick("openCreate()", "New policy")
				}
			}
			if len(p.Policies) == 0 {
				if p.Can("escalation_policies.write") {
					@EmptyStateModal("No escalation policies yet.", "openCreate()", "Create a policy")
				} else {
					@EmptyState("No escalation policies yet.", "", "")
				}
			} else {
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
					for _, ep := range p.Policies {
						<div class="card card-pad">
							<div class="flex items-start justify-between gap-3 mb-3">
								<div class="min-w-0">
									<div class="flex items-center gap-2">
										<h2 class="text-md font-semibold truncate">{ ep.Name }</h2>
										if ep.Enabled {
											<span class="badge badge-emerald">Enabled</span>
										} else {
											<span class="badge">Disabled</span>
										}
										if ep.Repeat {
											<span class="badge">Repeats</span>
										}
									</div>
									if ep.Description != "" {
										<p class="text-sm text-muted mt-1">{ ep.Description }</p>
									}
								</div>
								if p.Can("escalation_policies.write") {
									<div class="flex items-center gap-0.5 shrink-0">
										<button type="button" @click={ fmt.Sprintf("openEdit(%s)", ToJSON(ep)) } class="row-action" title="Edit" aria-label={ "Edit " + ep.Name }>
											@iconEdit()
										</button>
										@DeleteButton(fmt.Sprintf("%s/escalation-policies/%d/delete", p.BasePath, ep.ID), "Delete this escalation policy?")
									</div>
								}
							</div>
							<ol class="space-y-1.5">
								for i, step := range ep.Steps {
									<li class="flex items-baseline gap-2 text-sm">
										<span class="w-5 text-right text-muted tabular-nums shrink-0">{ fmt.Sprint(i + 1) }.</span>
										<span class="text-white shrink-0">
											if step.DelayMinutes == 0 {
												Immediately
											} else {
												{ fmt.Sprintf("After %d min", step.DelayMinutes) }
											}
										</span>
										<span class="text-muted-light min-w-0">→ { channelNames(p.Channels, step.NotificationChannelIDs) }</span>
									</li>
								}
							</ol>
						</div>
					}
				</div>
			}
			@FormModal("showForm", "max-w-lg", "editId ? 'Edit escalation policy' : 'New escalation policy'") {
				<form method="POST" :action="formAction" class="space-y-4">
					<div>
						<label class="form-label" for="ep-name">Name</label>
						<input type="text" id="ep-name" name="name" x-model="formData.name" class="form-input" required/>
					</div>
					<div>
						<label class="form-label" for="ep-description">Description <span class="text-muted font-normal">(optional)</span></label>
						<input type="text" id="ep-description" name="description" x-model="formData.description" class="form-input"/>
					</div>
					<div class="flex flex-wrap items-center gap-5">
						<label class="flex items-center gap-2 cursor-pointer">
							<input type="checkbox" name="enabled" x-model="formData.enabled" class="form-checkbox"/>
							<span class="text-sm text-muted-light">Enabled</span>
						</label>
						<label class="flex items-center gap-2 cursor-pointer">
							<input type="checkbox" name="repeat" x-model="formData.repeat" class="form-checkbox"/>
							<span class="text-sm text-muted-light">Repeat after the last step</span>
						</label>
					</div>
					<div>
						<div class="form-label">Steps</div>
						<div class="space-y-2">
							<template x-for="(step, idx) in formData.steps" :key="idx">
								<fieldset class="rounded-control border border-line-light p-3 space-y-3">
									<div class="flex items-center justify-between">
										<legend class="text-sm font-medium text-white" x-text="'Step ' + (idx + 1)"></legend>
										<div class="flex items-center gap-0.5">
											<button type="button" @click="moveStep(idx, -1)" x-show="idx > 0" aria-label="Move step up" title="Move up" class="row-action">
												<svg aria-hidden="true" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m18 15-6-6-6 6"></path></svg>
											</button>
											<button type="button" @click="moveStep(idx, 1)" x-show="idx < formData.steps.length - 1" aria-label="Move step down" title="Move down" class="row-action">
												<svg aria-hidden="true" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg>
											</button>
											<button type="button" @click="removeStep(idx)" aria-label="Remove step" title="Remove" class="row-action hover:text-crit!">
												@iconX()
											</button>
										</div>
									</div>
									<div>
										<label class="form-label-sm" :for="'step-delay-' + idx">Delay (minutes)</label>
										<input type="number" min="0" :id="'step-delay-' + idx" x-model.number="step.delay_minutes" class="form-input w-28 h-8"/>
										<input type="hidden" name="step_delay_minutes[]" :value="step.delay_minutes"/>
									</div>
									<div>
										<div class="form-label-sm">Notify</div>
										<div class="flex flex-wrap gap-1.5">
											for _, ch := range p.Channels {
												<label class="inline-flex items-center gap-2 rounded-control border border-line-light px-2 h-8 text-sm cursor-pointer select-none hover:bg-surface-200" :class={ fmt.Sprintf("step.channel_ids.includes(%d) && 'border-brand'", ch.ID) }>
													<input type="checkbox" :checked={ fmt.Sprintf("step.channel_ids.includes(%d)", ch.ID) } @change={ fmt.Sprintf("toggleChannel(idx, %d)", ch.ID) } class="form-checkbox"/>
													<span class="text-white">{ ch.Name }</span>
												</label>
											}
										</div>
										<input type="hidden" name="step_channels[]" :value="JSON.stringify(step.channel_ids)"/>
									</div>
								</fieldset>
							</template>
						</div>
						<button type="button" @click="addStep()" class="btn-secondary btn-sm mt-2">Add step</button>
					</div>
					<div class="flex items-center gap-2 pt-1">
						<button type="submit" class="btn-primary" x-text="editId ? 'Save changes' : 'Create policy'"></button>
						<button type="button" @click="showForm = false" class="btn-secondary">Cancel</button>
					</div>
				</form>
			}
		</div>
	}
}

func escalationXData(p EscalationPolicyListParams) string {
	return fmt.Sprintf(`{
		showForm: false,
		editId: null,
		formAction: '%s/escalation-policies',
		formData: { name: '', description: '', enabled: true, repeat: false, steps: [] },
		openCreate() {
			this.editId = null;
			this.formAction = '%s/escalation-policies';
			this.formData = { name: '', description: '', enabled: true, repeat: false, steps: [{ delay_minutes: 0, channel_ids: [] }] };
			this.showForm = true;
		},
		openEdit(ep) {
			this.editId = ep.id;
			this.formAction = '%s/escalation-policies/' + ep.id;
			this.formData = {
				name: ep.name,
				description: ep.description,
				enabled: ep.enabled,
				repeat: ep.repeat,
				steps: (ep.steps || []).map(s => ({ delay_minutes: s.delay_minutes, channel_ids: [...s.notification_channel_ids] }))
			};
			if (this.formData.steps.length === 0) this.formData.steps.push({ delay_minutes: 0, channel_ids: [] });
			this.showForm = true;
		},
		addStep() { this.formData.steps.push({ delay_minutes: 0, channel_ids: [] }) },
		removeStep(idx) { this.formData.steps.splice(idx, 1) },
		moveStep(idx, dir) {
			let s = this.formData.steps;
			let t = idx + dir;
			if (t < 0 || t >= s.length) return;
			[s[idx], s[t]] = [s[t], s[idx]];
		},
		toggleChannel(stepIdx, chId) {
			let ids = this.formData.steps[stepIdx].channel_ids;
			let i = ids.indexOf(chId);
			if (i >= 0) ids.splice(i, 1); else ids.push(chId);
		}
	}`, JSEscapeString(p.BasePath), JSEscapeString(p.BasePath), JSEscapeString(p.BasePath))
}
