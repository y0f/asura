package views

import (
	"fmt"

	"github.com/y0f/asura/internal/storage"
)

type DailyBar struct {
	Date      string
	UptimePct float64
	HasData   bool
	Label     string
}

type MonitorWithUptime struct {
	Monitor     *storage.Monitor
	DailyBars   []DailyBar
	Uptime90d   float64
	UptimeLabel string
	GroupName   string
}

type MonitorGroup struct {
	Name     string
	Monitors []MonitorWithUptime
}

type PublicStatusPageParams struct {
	Title                string
	BasePath             string
	Config               *storage.StatusPage
	Monitors             []MonitorWithUptime
	Groups               []MonitorGroup
	HasGroups            bool
	Overall              string
	Incidents            []*storage.Incident
	HasIncidents         bool
	SubscriptionsEnabled bool
	Message              string
}

type SubscriberResultParams struct {
	Title    string
	BasePath string
	Slug     string
	Heading  string
	Message  string
	Success  bool
}

type StatusPageAuthParams struct {
	Title    string
	BasePath string
	Slug     string
	Error    string
}

templ publicHead(basePath, title string) {
	<meta charset="UTF-8"/>
	<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
	<script>(function(){try{var d=window.matchMedia("(prefers-color-scheme: dark)").matches;document.documentElement.setAttribute("data-theme",d?"dark":"light");}catch(e){}})();</script>
	<title>{ title }</title>
	<link rel="preload" href={ basePath + "/static/fonts/inter.woff2" } as="font" type="font/woff2" crossorigin/>
	<link rel="stylesheet" href={ Asset(basePath, "tailwind.css") }/>
	{ children... }
}

// publicOverall turns the overall status into visitor-facing wording. A single
// failing monitor out of many is a partial outage, not a major one.
func publicOverall(p PublicStatusPageParams) (label, tone string) {
	switch p.Overall {
	case "operational":
		return "All systems operational", "ok"
	case "degraded":
		return "Degraded performance", "warn"
	}
	total, down := 0, 0
	for _, m := range p.allMonitors() {
		total++
		if m.Monitor.Status == "down" {
			down++
		}
	}
	if total > 0 && down*2 >= total {
		return "Major outage", "crit"
	}
	return "Partial outage", "major"
}

func (p PublicStatusPageParams) allMonitors() []MonitorWithUptime {
	if !p.HasGroups {
		return p.Monitors
	}
	var all []MonitorWithUptime
	for _, g := range p.Groups {
		all = append(all, g.Monitors...)
	}
	return all
}

// publicStatus is the visitor-facing wording for a monitor status.
func publicStatus(status string) (label, tone string) {
	switch status {
	case "up":
		return "Operational", "ok"
	case "degraded":
		return "Degraded", "warn"
	case "down":
		return "Outage", "crit"
	case "paused":
		return "Paused", "neutral"
	default:
		return "No data", "neutral"
	}
}

func publicIncidentStatus(status string) string {
	switch status {
	case "open":
		return "Investigating"
	case "acknowledged":
		return "Identified"
	case "resolved":
		return "Resolved"
	default:
		return capitalize(status)
	}
}

templ PublicStatusPage(p PublicStatusPageParams) {
	<!DOCTYPE html>
	<html lang="en" data-theme="dark">
		<head>
			@publicHead(p.BasePath, p.Title) {
				if p.Config != nil && p.Config.FaviconURL != "" {
					<link rel="icon" href={ p.Config.FaviconURL }/>
				} else {
					<link rel="icon" href={ p.BasePath + "/static/favicon.ico" }/>
				}
				if p.Config != nil {
					<link rel="alternate" type="application/rss+xml" title={ p.Title + " RSS" } href={ p.BasePath + "/" + p.Config.Slug + "/rss" }/>
				}
				<script defer src={ Asset(p.BasePath, "alpine.min.js") }></script>
				if p.Config != nil && p.Config.CustomCSS != "" {
					<style>
						{ p.Config.CustomCSS }
					</style>
				}
			}
		</head>
		<body class="bg-surface text-muted-light font-sans min-h-screen antialiased">
			<main class="max-w-3xl mx-auto px-4 py-12 sm:px-6 sm:py-16">
				<header class="mb-8">
					if p.Config != nil && p.Config.LogoURL != "" {
						<img src={ p.Config.LogoURL } alt={ p.Title } class="h-9 object-contain mb-6"/>
					}
					<h1 class="text-3xl font-bold">{ p.Title }</h1>
					if p.Config != nil && p.Config.Description != "" {
						<p class="subtitle mt-1.5">{ p.Config.Description }</p>
					}
				</header>
				if p.Config != nil && p.Config.CustomHeaderHTML != "" {
					@templ.Raw(p.Config.CustomHeaderHTML)
				}
				@statusOverallBanner(p)
				if p.HasGroups {
					for _, g := range p.Groups {
						if g.Name != "" {
							<h2 class="text-lg font-semibold mt-8 mb-3">{ g.Name }</h2>
						}
						<div class="panel divide-y divide-line mb-4">
							for _, mwu := range g.Monitors {
								@statusMonitorRow(mwu)
							}
						</div>
					}
				} else if len(p.Monitors) > 0 {
					<div class="panel divide-y divide-line">
						for _, mwu := range p.Monitors {
							@statusMonitorRow(mwu)
						}
					</div>
				} else {
					<div class="card px-6 py-10 text-center text-sm text-muted">Nothing is being monitored on this page yet.</div>
				}
				if p.Config != nil && p.Config.ShowIncidents && p.HasIncidents {
					<section class="mt-12" aria-labelledby="incidents-title">
						<h2 id="incidents-title" class="text-lg font-semibold mb-3">Recent incidents</h2>
						<div class="panel divide-y divide-line">
							for _, inc := range p.Incidents {
								<div class="px-5 py-4">
									<div class="flex items-center justify-between gap-3">
										<span class="text-md font-medium text-white truncate">{ inc.MonitorName }</span>
										<span class={ "inline-flex items-center gap-1.5 text-sm shrink-0", StatusColor(inc.Status) }><span class={ "dot", StatusDot(inc.Status) }></span>{ publicIncidentStatus(inc.Status) }</span>
									</div>
									<div class="mt-1.5 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted">
										<time datetime={ absTime(inc.StartedAt) }>{ inc.StartedAt.UTC().Format("Jan 2, 15:04 UTC") }</time>
										if inc.ResolvedAt != nil {
											<span>Resolved after { IncidentDuration(inc.StartedAt, inc.ResolvedAt) }</span>
										}
									</div>
								</div>
							}
						</div>
					</section>
				}
				if p.Message != "" {
					<div role="status" class="mt-6 rounded-card border border-line-light bg-surface-50 px-4 py-3 text-sm text-white">{ p.Message }</div>
				}
				if p.SubscriptionsEnabled {
					@statusSubscribeWidget(p.BasePath, p.Config.Slug)
				}
				<footer class="mt-14 pt-5 border-t border-line flex items-center justify-between gap-3 text-sm text-muted">
					if p.Config != nil {
						<a href={ templ.SafeURL(p.BasePath + "/" + p.Config.Slug + "/rss") } class="hover:text-white">RSS feed</a>
					}
					<a href="https://github.com/y0f/asura" target="_blank" rel="noopener" class="flex items-center gap-1.5 hover:text-white">Powered by <img src={ p.BasePath + "/static/logo.gif" } alt="Asura" class="h-3.5 w-auto"/></a>
				</footer>
			</main>
			if p.Config != nil && p.Config.AnalyticsScript != "" {
				@templ.Raw(p.Config.AnalyticsScript)
			}
		</body>
	</html>
}

templ statusSubscribeWidget(basePath, slug string) {
	<section class="mt-12" x-data="{open: false, type: 'email'}" aria-labelledby="subscribe-title">
		<div class="card card-pad">
			<div class="flex flex-wrap items-center justify-between gap-3">
				<div>
					<h2 id="subscribe-title" class="text-lg font-semibold">Get updates</h2>
					<p class="subtitle mt-0.5">Be notified when an incident is opened or resolved.</p>
				</div>
				<button type="button" @click="open = !open" :aria-expanded="open" class="btn-secondary">Subscribe</button>
			</div>
			<form x-show="open" x-cloak method="POST" action={ templ.SafeURL(basePath + "/" + slug + "/subscribe") } class="mt-4 pt-4 border-t border-line space-y-4">
				<div class="flex gap-1" role="group" aria-label="Delivery method">
					<button type="button" @click="type = 'email'" :aria-pressed="type === 'email'"
						:class="type === 'email' ? 'filter-active' : 'filter-inactive'" class="filter-tab">Email</button>
					<button type="button" @click="type = 'webhook'" :aria-pressed="type === 'webhook'"
						:class="type === 'webhook' ? 'filter-active' : 'filter-inactive'" class="filter-tab">Webhook</button>
				</div>
				<input type="hidden" name="type" :value="type"/>
				<div x-show="type === 'email'">
					<label class="form-label" for="sub-email">Email address</label>
					<input id="sub-email" type="email" name="email" :required="type === 'email'" :disabled="type !== 'email'" placeholder="you@example.com" class="form-input"/>
					<p class="form-hint">You'll get a confirmation email first.</p>
				</div>
				<div x-show="type === 'webhook'" x-cloak>
					<label class="form-label" for="sub-webhook">Webhook URL</label>
					<input id="sub-webhook" type="url" name="webhook_url" :required="type === 'webhook'" :disabled="type !== 'webhook'" placeholder="https://example.com/webhook" class="form-input"/>
					<p class="form-hint">Incident events are POSTed to this URL as JSON.</p>
				</div>
				<button type="submit" class="btn-primary">Subscribe</button>
			</form>
		</div>
	</section>
}

templ SubscriberResultPage(p SubscriberResultParams) {
	<!DOCTYPE html>
	<html lang="en" data-theme="dark">
		<head>
			@publicHead(p.BasePath, p.Heading+" · "+p.Title) {
				<link rel="icon" href={ p.BasePath + "/static/favicon.ico" }/>
			}
		</head>
		<body class="bg-surface text-muted-light font-sans min-h-screen antialiased flex items-center justify-center px-4">
			<main class="w-full max-w-sm card p-6">
				<div class="flex items-center gap-2 mb-2">
					if p.Success {
						<span class="dot bg-ok"></span>
					} else {
						<span class="dot bg-crit"></span>
					}
					<h1 class="text-xl font-bold">{ p.Heading }</h1>
				</div>
				<p class="text-sm text-muted-light mb-5">{ p.Message }</p>
				<a href={ templ.SafeURL(p.BasePath + "/" + p.Slug) } class="btn-secondary">Back to { p.Title }</a>
			</main>
		</body>
	</html>
}

templ StatusPageAuthPage(p StatusPageAuthParams) {
	<!DOCTYPE html>
	<html lang="en" data-theme="dark">
		<head>
			@publicHead(p.BasePath, p.Title) {
				<link rel="icon" href={ p.BasePath + "/static/favicon.ico" }/>
			}
		</head>
		<body class="bg-surface text-muted-light font-sans min-h-screen antialiased flex items-center justify-center px-4">
			<main class="w-full max-w-sm card p-6">
				<h1 class="text-xl font-bold">{ p.Title }</h1>
				<p class="subtitle mt-1 mb-5">This status page is password protected.</p>
				<form method="POST" action={ templ.SafeURL(p.BasePath + "/" + p.Slug + "/auth") } class="space-y-4">
					<div>
						<label class="form-label" for="sp-password">Password</label>
						<input id="sp-password" type="password" name="password" autofocus required class="form-input"/>
					</div>
					if p.Error != "" {
						<p role="alert" class="text-sm text-crit">Incorrect password. Try again.</p>
					}
					<button type="submit" class="btn-primary w-full h-9">Continue</button>
				</form>
			</main>
		</body>
	</html>
}

templ statusOverallBanner(p PublicStatusPageParams) {
	{{ label, tone := publicOverall(p) }}
	<div role="status" class={ "mb-8 rounded-card border px-5 py-4 flex items-center gap-3 bg-surface-50", "border-" + tone + "/50" }>
		<span class={ "dot w-2.5 h-2.5", "bg-" + tone }></span>
		<span class="text-lg font-semibold text-white">{ label }</span>
	</div>
}

templ statusMonitorRow(mwu MonitorWithUptime) {
	{{ label, tone := publicStatus(mwu.Monitor.Status) }}
	<div class="px-5 py-4">
		<div class="flex items-center justify-between gap-3 mb-3">
			<span class="text-md font-medium text-white truncate min-w-0">{ mwu.Monitor.Name }</span>
			<div class="flex items-center gap-4 shrink-0">
				<span class="text-sm text-muted tabular-nums">{ mwu.UptimeLabel }</span>
				<span class={ "inline-flex items-center gap-1.5 text-sm", toneTextClass(tone) }><span class={ "dot", toneDotClass(tone) }></span>{ label }</span>
			</div>
		</div>
		<div x-data="{tooltip: '', show: false, mx: 0, my: 0}">
			<div class="rounded-[3px] overflow-hidden" aria-hidden="true">
				@templ.Raw(UptimeBarsSVG(mwu.DailyBars))
			</div>
			<p class="sr-only">{ uptimeSummary(mwu) }</p>
			<div x-show="show" x-cloak
				class="fixed z-50 px-2.5 py-1.5 bg-surface-100 border border-line-light rounded-control text-xs text-white shadow-lg pointer-events-none whitespace-nowrap"
				:style="`top: ${my - 40}px; left: ${mx}px`"
				x-text="tooltip"></div>
		</div>
		<div class="flex items-center justify-between mt-2 text-xs text-muted">
			<span>90 days ago</span>
			<span>Today</span>
		</div>
	</div>
}

func uptimeSummary(mwu MonitorWithUptime) string {
	bad := 0
	for _, b := range mwu.DailyBars {
		if b.HasData && b.UptimePct < 99.9 {
			bad++
		}
	}
	if bad == 0 {
		return mwu.UptimeLabel + " uptime over the last 90 days, no days with notable downtime."
	}
	return fmt.Sprintf("%s uptime over the last 90 days, %d days with downtime.", mwu.UptimeLabel, bad)
}
