package views

import (
	"fmt"
	"strings"

	"github.com/y0f/asura/v3/internal/storage"
)

type DailyBar struct {
	Date      string
	UptimePct float64
	HasData   bool
	Label     string
}

type MonitorWithUptime struct {
	Monitor     *storage.Monitor
	DailyBars   []DailyBar
	Uptime90d   float64
	UptimeLabel string
	GroupName   string
}

type MonitorGroup struct {
	Name     string
	Monitors []MonitorWithUptime
}

type PublicStatusPageParams struct {
	Title                string
	BasePath             string
	Config               *storage.StatusPage
	Monitors             []MonitorWithUptime
	Groups               []MonitorGroup
	HasGroups            bool
	Overall              string
	Incidents            []*storage.Incident
	HasIncidents         bool
	SubscriptionsEnabled bool
	Message              string
}

type SubscriberResultParams struct {
	Title    string
	BasePath string
	Slug     string
	Heading  string
	Message  string
	Success  bool
}

type StatusPageAuthParams struct {
	Title    string
	BasePath string
	Slug     string
	Error    string
}

// Styles are sanitized when saved. Escape the HTML raw-text delimiter as CSS
// as well, so legacy values cannot close the style element during rendering.
func publicCustomStyle(css string) string {
	return "<style>" + strings.ReplaceAll(css, "</", `\3c /`) + "</style>"
}

templ publicHead(basePath, title string) {
	<meta charset="UTF-8"/>
	<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
	<script>(function(){try{var d=window.matchMedia("(prefers-color-scheme: dark)").matches;document.documentElement.setAttribute("data-theme",d?"dark":"light");}catch(e){}})();</script>
	<title>{ title }</title>
	<link rel="preload" href={ basePath + "/static/fonts/inter.woff2" } as="font" type="font/woff2" crossorigin/>
	<link rel="stylesheet" href={ Asset(basePath, "tailwind.css") }/>
	{ children... }
}

// publicOverall turns the overall status into visitor-facing wording. A single
// failing monitor out of many is a partial outage, not a major one.
func publicOverall(p PublicStatusPageParams) (label, tone string) {
	switch p.Overall {
	case "unknown":
		return "Awaiting status data", "muted"
	case "operational":
		return "All systems operational", "ok"
	case "degraded":
		return "Degraded performance", "warn"
	}
	total, down := 0, 0
	for _, m := range p.allMonitors() {
		total++
		if m.Monitor.Status == "down" {
			down++
		}
	}
	if total > 0 && down*2 >= total {
		return "Major outage", "crit"
	}
	return "Partial outage", "major"
}

func (p PublicStatusPageParams) allMonitors() []MonitorWithUptime {
	if !p.HasGroups {
		return p.Monitors
	}
	var all []MonitorWithUptime
	for _, g := range p.Groups {
		all = append(all, g.Monitors...)
	}
	return all
}

// publicStatus is the visitor-facing wording for a monitor status.
func publicStatus(status string) (label, tone string) {
	switch status {
	case "up":
		return "Operational", "ok"
	case "degraded":
		return "Degraded", "warn"
	case "down":
		return "Outage", "crit"
	case "paused":
		return "Paused", "neutral"
	default:
		return "No data", "neutral"
	}
}

func publicIncidentStatus(status string) string {
	switch status {
	case "open":
		return "Investigating"
	case "acknowledged":
		return "Identified"
	case "resolved":
		return "Resolved"
	default:
		return capitalize(status)
	}
}

templ PublicStatusPage(p PublicStatusPageParams) {
	<!DOCTYPE html>
	<html lang="en" data-theme="dark">
		<head>
			@publicHead(p.BasePath, p.Title) {
				if p.Config != nil && p.Config.FaviconURL != "" {
					<link rel="icon" href={ p.Config.FaviconURL }/>
				} else {
					<link rel="icon" href={ p.BasePath + "/static/favicon.ico" }/>
				}
				if p.Config != nil {
					<link rel="alternate" type="application/rss+xml" title={ p.Title + " RSS" } href={ p.BasePath + "/" + p.Config.Slug + "/rss" }/>
				}
				<script defer src={ Asset(p.BasePath, "alpine.min.js") }></script>
				if p.Config != nil && p.Config.CustomCSS != "" {
					@templ.Raw(publicCustomStyle(p.Config.CustomCSS))
				}
			}
		</head>
		<body class="public-status bg-surface text-muted-light font-sans min-h-screen antialiased">
			<main class="status-container">
				<header class="status-header">
					<div class="min-w-0">
						if p.Config != nil && p.Config.LogoURL != "" {
							<img src={ p.Config.LogoURL } alt={ p.Title } class="status-logo"/>
						}
						<h1>{ p.Title }</h1>
						if p.Config != nil && p.Config.Description != "" {
							<p>{ p.Config.Description }</p>
						}
					</div>
					if p.SubscriptionsEnabled {
						<a href="#subscribe-title" class="btn-secondary">Get updates</a>
					}
				</header>
				if p.Config != nil && p.Config.CustomHeaderHTML != "" {
					@templ.Raw(p.Config.CustomHeaderHTML)
				}
				@statusOverallBanner(p)
				<section class="status-services" aria-labelledby="services-title">
					<div class="status-section-heading">
						<h2 id="services-title">Services</h2>
						<p>Availability over the last 90 days</p>
					</div>
					if p.HasGroups {
						for _, g := range p.Groups {
							<section class="status-group">
								if g.Name != "" {
									<h3>{ g.Name }</h3>
								}
								<div class="status-service-list panel">
									for _, mwu := range g.Monitors {
										@statusMonitorRow(mwu)
									}
								</div>
							</section>
						}
					} else if len(p.Monitors) > 0 {
						<div class="status-service-list panel">
							for _, mwu := range p.Monitors {
								@statusMonitorRow(mwu)
							}
						</div>
					} else {
						<div class="status-empty">No services have been published on this page.</div>
					}
				</section>
				if p.Config != nil && p.Config.ShowIncidents && p.HasIncidents {
					<section class="status-incidents" aria-labelledby="incidents-title">
						<div class="status-section-heading">
							<h2 id="incidents-title">Recent incidents</h2>
							<p>All times UTC</p>
						</div>
						<div class="status-incident-list panel">
							for _, inc := range p.Incidents {
								<article class="status-incident">
									<div class="status-incident-heading">
										<h3>{ inc.MonitorName }</h3>
										<span class="status-state" data-tone={ StatusTone(inc.Status) }>
											@statusSymbol(StatusTone(inc.Status))
											<span>{ publicIncidentStatus(inc.Status) }</span>
										</span>
									</div>
									<div class="status-incident-meta">
										<time datetime={ isoTime(inc.StartedAt) }>{ inc.StartedAt.UTC().Format("Jan 2, 15:04 UTC") }</time>
										if inc.ResolvedAt != nil {
											<span>Resolved after { IncidentDuration(inc.StartedAt, inc.ResolvedAt) }</span>
										}
									</div>
								</article>
							}
						</div>
					</section>
				}
				if p.Message != "" {
					<div role="status" class="mt-6 rounded-card border border-line-light bg-surface-50 px-4 py-3 text-sm text-white">{ p.Message }</div>
				}
				if p.SubscriptionsEnabled {
					@statusSubscribeWidget(p.BasePath, p.Config.Slug)
				}
				<footer class="status-footer">
					if p.Config != nil {
						<a href={ templ.SafeURL(p.BasePath + "/" + p.Config.Slug + "/rss") }>RSS feed</a>
					}
					<a href="https://github.com/y0f/asura" target="_blank" rel="noopener" class="inline-flex items-center gap-1.5">Powered by <img src={ p.BasePath + "/static/logo.gif" } alt="Asura" class="h-3.5 w-auto"/></a>
				</footer>
			</main>
			if p.Config != nil && p.Config.AnalyticsScript != "" {
				@templ.Raw(p.Config.AnalyticsScript)
			}
		</body>
	</html>
}

templ statusSubscribeWidget(basePath, slug string) {
	<section class="status-subscribe" x-data="{open: false, type: 'email'}" aria-labelledby="subscribe-title">
		<div class="card card-pad">
			<div class="flex flex-wrap items-center justify-between gap-3">
				<div>
					<h2 id="subscribe-title" class="text-lg font-semibold">Get updates</h2>
					<p class="subtitle mt-0.5">Be notified when an incident is opened or resolved.</p>
				</div>
				<button type="button" @click="open = !open" :aria-expanded="open" class="btn-secondary">Subscribe</button>
			</div>
			<form x-show="open" x-cloak method="POST" action={ templ.SafeURL(basePath + "/" + slug + "/subscribe") } class="mt-4 pt-4 border-t border-line space-y-4">
				<div class="flex gap-1" role="group" aria-label="Delivery method">
					<button
						type="button"
						@click="type = 'email'"
						:aria-pressed="type === 'email'"
						:class="type === 'email' ? 'filter-active' : 'filter-inactive'"
						class="filter-tab"
					>Email</button>
					<button
						type="button"
						@click="type = 'webhook'"
						:aria-pressed="type === 'webhook'"
						:class="type === 'webhook' ? 'filter-active' : 'filter-inactive'"
						class="filter-tab"
					>Webhook</button>
				</div>
				<input type="hidden" name="type" :value="type"/>
				<div x-show="type === 'email'">
					<label class="form-label" for="sub-email">Email address</label>
					<input id="sub-email" type="email" name="email" :required="type === 'email'" :disabled="type !== 'email'" placeholder="you@example.com" class="form-input"/>
					<p class="form-hint">You'll get a confirmation email first.</p>
				</div>
				<div x-show="type === 'webhook'" x-cloak>
					<label class="form-label" for="sub-webhook">Webhook URL</label>
					<input id="sub-webhook" type="url" name="webhook_url" :required="type === 'webhook'" :disabled="type !== 'webhook'" placeholder="https://example.com/webhook" class="form-input"/>
					<p class="form-hint">Incident events are POSTed to this URL as JSON.</p>
				</div>
				<button type="submit" class="btn-primary">Subscribe</button>
			</form>
		</div>
	</section>
}

templ SubscriberResultPage(p SubscriberResultParams) {
	<!DOCTYPE html>
	<html lang="en" data-theme="dark">
		<head>
			@publicHead(p.BasePath, p.Heading+" · "+p.Title) {
				<link rel="icon" href={ p.BasePath + "/static/favicon.ico" }/>
			}
		</head>
		<body class="bg-surface text-muted-light font-sans min-h-screen antialiased flex items-center justify-center px-4">
			<main class="w-full max-w-sm card p-6">
				<div class="flex items-center gap-2 mb-2">
					if p.Success {
						<span class="dot bg-ok"></span>
					} else {
						<span class="dot bg-crit"></span>
					}
					<h1 class="text-xl font-bold">{ p.Heading }</h1>
				</div>
				<p class="text-sm text-muted-light mb-5">{ p.Message }</p>
				if p.Slug != "" {
					<a href={ templ.SafeURL(p.BasePath + "/" + p.Slug) } class="btn-secondary">Back to { p.Title }</a>
				}
			</main>
		</body>
	</html>
}

templ StatusPageAuthPage(p StatusPageAuthParams) {
	<!DOCTYPE html>
	<html lang="en" data-theme="dark">
		<head>
			@publicHead(p.BasePath, p.Title) {
				<link rel="icon" href={ p.BasePath + "/static/favicon.ico" }/>
			}
		</head>
		<body class="bg-surface text-muted-light font-sans min-h-screen antialiased flex items-center justify-center px-4">
			<main class="w-full max-w-sm card p-6">
				<h1 class="text-xl font-bold">{ p.Title }</h1>
				<p class="subtitle mt-1 mb-5">This status page is password protected.</p>
				<form method="POST" action={ templ.SafeURL(p.BasePath + "/" + p.Slug + "/auth") } class="space-y-4">
					<div>
						<label class="form-label" for="sp-password">Password</label>
						<input id="sp-password" type="password" name="password" autocomplete="current-password" autofocus required class="form-input"/>
					</div>
					if p.Error != "" {
						<p role="alert" class="text-sm text-crit">Incorrect password. Try again.</p>
					}
					<button type="submit" class="btn-primary w-full h-9">Continue</button>
				</form>
			</main>
		</body>
	</html>
}

// Shapes retain their meaning when status colours cannot be distinguished.
templ statusSymbol(tone string) {
	<svg aria-hidden="true" focusable="false" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
		switch tone {
			case "ok":
				<circle cx="10" cy="10" r="7.25"></circle><path d="m6.5 10 2.25 2.25 4.75-4.75"></path>
			case "warn":
				<path d="m10 2.75 7.25 13H2.75Z"></path><path d="M10 7v3.5m0 2.5h.01"></path>
			case "crit", "major":
				<path d="m7 2.75-4.25 4.25v6L7 17.25h6l4.25-4.25V7L13 2.75Z"></path><path d="m7.5 7.5 5 5m0-5-5 5"></path>
			default:
				<circle cx="10" cy="10" r="7.25"></circle><path d="M10 6v4l2.5 1.5"></path>
		}
	</svg>
}

func publicServiceSummary(p PublicStatusPageParams) string {
	counts := [4]int{}
	for _, m := range p.allMonitors() {
		switch m.Monitor.Status {
		case "up":
			counts[0]++
		case "degraded":
			counts[1]++
		case "down":
			counts[2]++
		default:
			counts[3]++
		}
	}
	var parts []string
	for i, word := range []string{"operational", "degraded", "outage", "awaiting data"} {
		if count := counts[i]; count > 0 {
			if i == 2 && count > 1 {
				word = "outages"
			}
			parts = append(parts, fmt.Sprintf("%d %s", count, word))
		}
	}
	if len(parts) == 0 {
		return "Service status will appear here when monitors are published."
	}
	return strings.Join(parts, " \u00b7 ")
}

templ statusOverallBanner(p PublicStatusPageParams) {
	{{ label, tone := publicOverall(p) }}
	<div role="status" class="status-overall" data-tone={ tone }>
		<div class="status-overall-icon">@statusSymbol(tone)</div>
		<div>
			<p class="status-overall-title">{ label }</p>
			<p class="status-overall-summary">{ publicServiceSummary(p) }</p>
		</div>
	</div>
}

templ statusMonitorRow(mwu MonitorWithUptime) {
	{{ label, tone := publicStatus(mwu.Monitor.Status) }}
	<div class="status-service">
		<div class="status-service-heading">
			<span class="status-service-name">{ mwu.Monitor.Name }</span>
			<span class="status-state" data-tone={ tone }>
				@statusSymbol(tone)
				<span>{ label }</span>
			</span>
		</div>
		if mwu.Monitor.HasSampledMetrics() {
			<div class="status-history" x-data="{tooltip: '', show: false, mx: 0, my: 0}">
				<div class="status-history-bars" aria-hidden="true">
					@templ.Raw(UptimeBarsSVG(mwu.DailyBars))
				</div>
				<p class="sr-only">{ uptimeSummary(mwu) }</p>
				<div x-show="show" x-cloak class="fixed z-50 px-2.5 py-1.5 bg-surface-100 border border-line-light rounded-control text-xs text-white shadow-lg pointer-events-none whitespace-nowrap" :style="`top: ${my - 40}px; left: ${mx}px`" x-text="tooltip"></div>
				<div class="status-history-labels"><span>90 days ago</span><span>{ mwu.UptimeLabel } uptime</span><span>Today</span></div>
				@DailyUptimeData(mwu.Monitor.Name+": daily uptime", mwu.DailyBars)
			</div>
		} else {
			<p class="status-reported">Reported status</p>
		}
	</div>
}

func uptimeSummary(mwu MonitorWithUptime) string {
	bad, measured := 0, 0
	for _, b := range mwu.DailyBars {
		if b.HasData {
			measured++
			if b.UptimePct < 99.9 {
				bad++
			}
		}
	}
	if measured == 0 {
		return "No check data for the last 90 days."
	}
	return fmt.Sprintf("%s uptime over the last 90 days; %d days with checks, %d below 99.9%% uptime.", mwu.UptimeLabel, measured, bad)
}
