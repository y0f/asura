package views

import (
	"fmt"
	"strings"

	"github.com/y0f/asura/internal/storage"
)

type MonitorFormParams struct {
	LayoutParams
	Monitor              *storage.Monitor
	HTTP                 storage.HTTPSettings
	TCP                  storage.TCPSettings
	DNS                  storage.DNSSettings
	TLS                  storage.TLSSettings
	WS                   storage.WebSocketSettings
	Cmd                  storage.CommandSettings
	Docker               storage.DockerSettings
	Domain               storage.DomainSettings
	GRPC                 storage.GRPCSettings
	MQTT                 storage.MQTTSettings
	SMTP                 storage.SMTPSettings
	SSH                  storage.SSHSettings
	Redis                storage.RedisSettings
	PostgreSQL           storage.PostgreSQLSettings
	UDP                  storage.UDPSettings
	MultiStep            storage.MultiStepHTTPSettings
	FollowRedirects      bool
	MaxRedirects         int
	HeadersJSON          string
	WsHeadersJSON        string
	AssertionsJSON       string
	SettingsJSON         string
	AssertionsRaw        string
	Groups               []*storage.MonitorGroup
	NotificationChannels []*storage.NotificationChannel
	SelectedChannelIDs   []int64
	Agents               []*storage.Agent
	Proxies              []*storage.Proxy
	EscalationPolicies   []*storage.EscalationPolicy
	AllTags              []*storage.Tag
	SelectedTags         []storage.MonitorTag
	// SecretsStored lists the secret settings keys that already have a value on
	// the server. Their values are never rendered; see SettingPassword.
	SecretsStored map[string]bool
}

func (p MonitorFormParams) canAssign(resource string) bool {
	creating := p.Monitor == nil || p.Monitor.ID == 0
	if creating && resource == "groups" {
		return p.HasCapability("monitors.create")
	}
	if !p.Can(resource + ".read") {
		return false
	}
	if creating {
		return p.HasCapability("monitors.assign")
	}
	return p.CanMonitor("monitors.assign", p.Monitor.ID, p.Monitor.GroupID)
}

func (p MonitorFormParams) canUseGroup(groupID *int64) bool {
	if p.Monitor == nil || p.Monitor.ID == 0 {
		return p.CanMonitor("monitors.create", 0, groupID)
	}
	current := p.Monitor.GroupID
	if (current == nil && groupID == nil) || (current != nil && groupID != nil && *current == *groupID) {
		return true
	}
	return p.canAssign("groups") && p.CanMonitor("monitors.update", 0, groupID) && p.CanMonitor("monitors.assign", 0, groupID)
}

func (p MonitorFormParams) isTagSelected(tagID int64) bool {
	for _, t := range p.SelectedTags {
		if t.TagID == tagID {
			return true
		}
	}
	return false
}

func (p MonitorFormParams) tagValue(tagID int64) string {
	for _, t := range p.SelectedTags {
		if t.TagID == tagID {
			return t.Value
		}
	}
	return ""
}

func (p MonitorFormParams) cmdArgsStr() string {
	return strings.Join(p.Cmd.Args, ", ")
}

func (p MonitorFormParams) monitorTypeOrDefault() string {
	if p.Monitor.Type != "" {
		return p.Monitor.Type
	}
	return "http"
}

func (p MonitorFormParams) httpMethodOrDefault() string {
	if p.HTTP.Method != "" {
		return p.HTTP.Method
	}
	return "GET"
}

// storedSecret reports whether a secret key is stored for monitorType. Stored
// secrets belong to the monitor's saved type (MQTT and Redis share the
// "password" key), and are only kept on save while the type is unchanged, so
// another type's field never claims to be saved.
func (p MonitorFormParams) storedSecret(monitorType, key string) bool {
	return p.Monitor != nil && p.Monitor.Type == monitorType && p.SecretsStored[key]
}

func (p MonitorFormParams) mtlsEnabled() bool {
	return p.HTTP.MTLSEnabled
}

func monitorFormXData(monType, httpMethod, authMethod, headersJSON, wsHeadersJSON, conditionsJSON string, mtlsEnabled bool, dnsServer string) string {
	mtlsVal := "false"
	if mtlsEnabled {
		mtlsVal = "true"
	}
	return `{
    monitorType: '` + JSEscapeString(monType) + `',
    dnsServer: '` + JSEscapeString(dnsServer) + `',
    jsonDNSServer: '` + JSEscapeString(dnsServer) + `',
    get proxyDNSServer() { return this.advancedSettings ? this.jsonDNSServer : this.dnsServer; },
    readJSONDNS(text) {
        try { const value = JSON.parse(text)?.server; this.jsonDNSServer = typeof value === 'string' ? value : ''; }
        catch { this.jsonDNSServer = ''; }
    },
    proxyInvalid: false,
    checkProxy(select) {
        this.proxyInvalid = Boolean(select.selectedOptions[0]?.disabled);
        select.setCustomValidity(this.proxyInvalid ? 'Choose a compatible proxy or No proxy.' : '');
    },
    advancedSettings: false,
    advancedAssertions: false,
    httpHeaders: ` + headersJSON + `,
    wsHeaders: ` + wsHeadersJSON + `,
    conditions: ` + conditionsJSON + `,
    httpMethod: '` + JSEscapeString(httpMethod) + `',
    authMethod: '` + JSEscapeString(authMethod) + `',
    mtlsEnabled: ` + mtlsVal + `,
    newCond() { return {type:'status_code',operator:'eq',target:'',value:'',degraded:false}; },
    addGroup() { this.conditions.groups.push({operator:'and',conditions:[this.newCond()]}); },
    operatorsFor(type) {
        switch(type) {
            case 'status_code': case 'response_time': case 'cert_expiry':
                return [['eq','='],['neq','!='],['gt','>'],['lt','<'],['gte','>='],['lte','<=']];
            case 'body_contains':
                return [['contains','contains'],['not_contains','not contains']];
            case 'body_regex':
                return [['matches','matches'],['not_matches','not matches']];
            case 'json_path':
                return [['eq','='],['neq','!='],['gt','>'],['lt','<'],['contains','contains'],['exists','exists']];
            case 'header':
                return [['eq','='],['neq','!='],['contains','contains'],['exists','exists']];
            case 'dns_record':
                return [['contains','contains'],['eq','=']];
            default:
                return [['eq','='],['neq','!=']];
        }
    },
    needsTarget(type) { return type === 'json_path' || type === 'header'; },
    needsValue(op) { return op !== 'exists'; }
}`
}

func tagSelectorData(p MonitorFormParams) string {
	var b strings.Builder
	b.WriteString("{tags:[")
	for i, tag := range p.AllTags {
		if i > 0 {
			b.WriteByte(',')
		}
		fmt.Fprintf(&b, "{id:%d,name:'%s',color:'%s',on:%v,val:'%s'}",
			tag.ID, JSEscapeString(tag.Name), JSEscapeString(tag.Color),
			p.isTagSelected(tag.ID), JSEscapeString(p.tagValue(tag.ID)))
	}
	b.WriteString("],toggleTag(i){this.tags[i].on=!this.tags[i].on;if(!this.tags[i].on)this.tags[i].val=''}}")
	return b.String()
}

func advancedSectionData(p MonitorFormParams) string {
	show := "false"
	if p.Monitor.ID != 0 {
		hasGroup := p.Monitor.GroupID != nil
		hasProxy := p.Monitor.ProxyID != nil
		hasTags := len(p.SelectedTags) > 0
		hasChannels := len(p.SelectedChannelIDs) > 0
		hasEscalation := p.Monitor.EscalationPolicyID != nil
		hasSLA := p.Monitor.SLATarget != 0
		hasAnomaly := p.Monitor.AnomalySensitivity != "" && p.Monitor.AnomalySensitivity != "off"
		hasResend := p.Monitor.ResendInterval != 0
		hasTrack := p.Monitor.TrackChanges
		hasUpside := p.Monitor.UpsideDown
		hasAgentOff := !p.Monitor.AgentEnabled
		hasAgents := len(p.Monitor.AgentIDs) > 0
		if hasGroup || hasProxy || hasTags || hasChannels || hasEscalation || hasSLA || hasAnomaly || hasResend || hasTrack || hasUpside || hasAgentOff || hasAgents {
			show = "true"
		}
	}
	return "{showAdvanced: " + show + "}"
}

func (p MonitorFormParams) header() PageHeaderParams {
	if p.Monitor.ID != 0 {
		return PageHeaderParams{Title: "Edit monitor", Subtitle: p.Monitor.Name, BackHref: fmt.Sprintf("%s/monitors/%d", p.BasePath, p.Monitor.ID), BackLabel: p.Monitor.Name}
	}
	if p.HasCapability("monitors.read") {
		return PageHeaderParams{Title: "New monitor", Subtitle: "Pick what to check and how often.", BackHref: p.BasePath + "/monitors", BackLabel: "Monitors"}
	}
	return PageHeaderParams{Title: "New monitor", Subtitle: "Pick what to check and how often.", BackHref: p.HomePath(), BackLabel: "Back"}
}

func intOrDefault(v, def int) string {
	if v != 0 {
		return fmt.Sprint(v)
	}
	return fmt.Sprint(def)
}

templ MonitorFormPage(p MonitorFormParams) {
	@Layout(p.LayoutParams) {
		@PageHeader(p.header())
		<div
			x-cloak
			x-data={ monitorFormXData(p.monitorTypeOrDefault(), p.httpMethodOrDefault(), p.HTTP.AuthMethod, p.HeadersJSON, p.WsHeadersJSON, p.AssertionsJSON, p.mtlsEnabled(), p.DNS.Server) }
			x-effect="if (monitorType === 'http_multi') advancedSettings = true"
		>
			<form
				method="POST"
				if p.Monitor.ID != 0 {
					action={ templ.SafeURL(fmt.Sprintf("%s/monitors/%d", p.BasePath, p.Monitor.ID)) }
				} else {
					action={ templ.SafeURL(p.BasePath + "/monitors") }
				}
				class="monitor-editor max-w-3xl space-y-5 pb-4"
			>
				<div class="card card-pad">
					<h2 class="text-lg font-semibold mb-4">General</h2>
					<div class="space-y-4">
						<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
							<div>
								<label class="form-label" for="name">Name</label>
								<input id="name" type="text" name="name" value={ p.Monitor.Name } required class="form-input" placeholder="My Website"/>
							</div>
							<div>
								<label class="form-label" for="type">Type</label>
								<select id="type" name="type" x-model="monitorType" class="form-select">
									<optgroup label="Network">
										<option value="http">HTTP(S)</option>
										<option value="http_multi">HTTP Multi-Step</option>
										<option value="tcp">TCP Port</option>
										<option value="icmp">Ping (ICMP)</option>
										<option value="dns">DNS Lookup</option>
										<option value="smtp">SMTP Mail Server</option>
										<option value="ssh">SSH Server</option>
									</optgroup>
									<optgroup label="Security">
										<option value="tls">TLS Certificate</option>
										<option value="domain">Domain Expiry</option>
									</optgroup>
									<optgroup label="Database">
										<option value="redis">Redis</option>
										<option value="postgresql">PostgreSQL</option>
									</optgroup>
									<optgroup label="Application">
										<option value="websocket">WebSocket</option>
										<option value="grpc">gRPC Health</option>
										<option value="mqtt">MQTT Broker</option>
										<option value="udp">UDP</option>
										<option value="docker">Docker Container</option>
										<option value="command">Command / Script</option>
									</optgroup>
									<optgroup label="Passive">
										<option value="heartbeat">Heartbeat (push)</option>
										<option value="manual">Manual Status</option>
									</optgroup>
								</select>
							</div>
						</div>
						<div x-show="monitorType !== 'heartbeat' && monitorType !== 'manual'" x-cloak>
							<label class="form-label" for="target" x-text="monitorType === 'docker' ? 'Container Name / ID' : 'Target'">Target</label>
							<input
								id="target"
								type="text"
								name="target"
								value={ p.Monitor.Target }
								:placeholder="{http:'https://example.com', http_multi:'https://example.com', tcp:'host:port', dns:'example.com', icmp:'8.8.8.8', tls:'example.com:443', websocket:'wss://example.com/ws', command:'/usr/bin/check', docker:'container-name', domain:'example.com', grpc:'host:port', mqtt:'broker:1883', smtp:'mail.example.com', ssh:'host:22', redis:'host:6379', postgresql:'host:5432', udp:'host:port'}[monitorType] || 'https://example.com'"
								class="form-input"
								if p.SecretsStored["target"] {
									aria-describedby="target-saved"
								}
							/>
							if p.SecretsStored["target"] {
								if p.Monitor.Type == "http" || p.Monitor.Type == "http_multi" || p.Monitor.Type == "websocket" {
									@StoredURLControl("target", "target")
								} else {
									@StoredTargetControl()
								}
							}
						</div>
						<div>
							<label class="form-label" for="description">Description <span class="text-muted font-normal">(optional)</span></label>
							<textarea id="description" name="description" rows="2" maxlength="5000" placeholder="Runbook notes, context, links…" class="form-input resize-y">{ p.Monitor.Description }</textarea>
						</div>
					</div>
				</div>
				<div x-show="monitorType !== 'heartbeat' && monitorType !== 'manual'" x-cloak>
					<div class="card card-pad">
						<h2 class="text-lg font-semibold mb-4">Schedule</h2>
						<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
							<div>
								<label class="form-label" for="interval">Check every</label>
								<div class="relative">
									<input id="interval" type="number" name="interval" value={ intOrDefault(p.Monitor.Interval, 60) } min="5" max="86400" class="form-input tabular-nums pr-10"/>
									<span class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-xs text-muted-light">sec</span>
								</div>
							</div>
							<div>
								<label class="form-label" for="timeout">Timeout after</label>
								<div class="relative">
									<input id="timeout" type="number" name="timeout" value={ intOrDefault(p.Monitor.Timeout, 10) } min="1" max="300" class="form-input tabular-nums pr-10"/>
									<span class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-xs text-muted-light">sec</span>
								</div>
							</div>
							<div>
								<label class="form-label" for="failure_threshold">Failures before alert</label>
								<input id="failure_threshold" type="number" name="failure_threshold" value={ intOrDefault(p.Monitor.FailureThreshold, 3) } min="1" class="form-input tabular-nums"/>
							</div>
							<div>
								<label class="form-label" for="success_threshold">Successes to recover</label>
								<input id="success_threshold" type="number" name="success_threshold" value={ intOrDefault(p.Monitor.SuccessThreshold, 1) } min="1" class="form-input tabular-nums"/>
							</div>
						</div>
					</div>
				</div>
				<div class="card card-pad" x-show="monitorType !== 'heartbeat' && monitorType !== 'icmp' && monitorType !== 'manual'" x-cloak>
					<div class="flex items-center justify-between mb-4">
						<h2 class="text-lg font-semibold">Settings</h2>
						<button type="button" x-show="monitorType !== 'http_multi'" @click="advancedSettings = !advancedSettings" class="btn-secondary btn-sm">
							<span x-text="advancedSettings ? 'Use form' : 'Edit as JSON'">Edit as JSON</span>
						</button>
					</div>
					<input type="hidden" name="settings_mode" :value="advancedSettings ? 'json' : 'form'"/>
					<div x-show="advancedSettings" x-cloak>
						<label class="sr-only" for="settings_json">Settings (JSON)</label>
						<textarea id="settings_json" name="settings_json" rows="8" placeholder="{}" class="form-input font-mono text-xs resize-y" @input="readJSONDNS($el.value)">{ p.SettingsJSON }</textarea>
						if len(p.settingsSecretPaths()) > 0 {
							<fieldset :disabled="!advancedSettings" class="mt-3 space-y-2">
								<legend class="form-label">Saved settings</legend>
								<p class="form-hint">Blank payloads and unchanged URL origins keep saved content. A blank header entry keeps its value; removing the entry deletes it. Paths below refer to the submitted JSON. Step indexes start at 0; recheck them after reordering.</p>
								for _, key := range p.settingsSecretPaths() {
									<label class="flex items-start gap-2 text-xs text-muted-light">
										<input type="checkbox" name="clear_secrets" value={ key } class="form-checkbox mt-0.5"/>
										<span>
											if secretPathIsURL(key) {
												Replace URL from entered JSON:
											} else {
												Remove saved value:
											}
											<code class="font-mono wrap-anywhere">{ key }</code>
										</span>
									</label>
								}
							</fieldset>
						}
						<p x-show="monitorType === 'http_multi'" class="form-hint">Multi-step HTTP checks are configured as JSON: a <code class="font-mono">steps</code> array of requests run in order.</p>
					</div>
					<fieldset x-show="!advancedSettings" :disabled="advancedSettings" class="min-w-0 space-y-4">
						@monitorHTTPSettings(p)
						@monitorTCPSettings(p)
						@monitorDNSSettings(p)
						@monitorTLSSettings(p)
						@monitorWSSettings(p)
						@monitorCommandSettings(p)
						@monitorDockerSettings(p)
						@monitorDomainSettings(p)
						@monitorGRPCSettings(p)
						@monitorMQTTSettings(p)
						@monitorSMTPSettings(p)
						@monitorSSHSettings(p)
						@monitorRedisSettings(p)
						@monitorPostgreSQLSettings(p)
						@monitorUDPSettings(p)
					</fieldset>
				</div>
				@monitorAssertions(p)
				<div x-data={ advancedSectionData(p) }>
					<button type="button" @click="showAdvanced = !showAdvanced" :aria-expanded="showAdvanced ? 'true' : 'false'" aria-controls="routing-behavior-panel" aria-label="Toggle routing and behavior settings" class="flex items-center gap-2 w-full text-left py-2 group cursor-pointer">
						<span class="text-lg font-semibold text-white">Routing &amp; behaviour</span>
						<svg focusable="false" aria-hidden="true" class="w-4 h-4 text-muted group-hover:text-white transition-transform" :class="showAdvanced && 'rotate-90'" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linejoin="round" stroke-linecap="round" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
					</button>
					<div id="routing-behavior-panel" x-show="showAdvanced" x-cloak class="mt-4">
						<div class="card card-pad">
							<div class="space-y-4">
								if p.canAssign("groups") && len(p.Groups) > 0 {
									<div>
										<label class="form-label" for="group_id">Group</label>
										<select id="group_id" name="group_id" required?={ !p.canUseGroup(nil) } class="form-select">
											if p.canUseGroup(nil) {
												<option value="">No group</option>
											} else {
												<option value="" disabled selected?={ p.Monitor.GroupID == nil }>Choose a group</option>
											}
											for _, g := range p.Groups {
												if p.canUseGroup(&g.ID) {
													<option
														value={ fmt.Sprint(g.ID) }
														if p.Monitor.GroupID != nil && *p.Monitor.GroupID == g.ID {
															selected
														}
													>{ g.Name }</option>
												}
											}
										</select>
									</div>
								}
								if p.canAssign("tags") {
									<div>
										<input type="hidden" name="relation_fields" value="tags"/>
										<div class="form-label">Tags</div>
										if len(p.AllTags) > 0 {
											<div x-data={ tagSelectorData(p) }>
												<div class="flex flex-wrap gap-1.5">
													for i, tag := range p.AllTags {
														<button
															type="button"
															@click={ fmt.Sprintf("toggleTag(%d)", i) }
															:class={ fmt.Sprintf("tags[%d].on ? 'border-brand text-white' : 'border-line-light text-muted-light'", i) }
															:aria-pressed={ fmt.Sprintf("tags[%d].on", i) }
															class="inline-flex items-center gap-2 rounded-control border px-2 h-8 text-sm cursor-pointer select-none hover:bg-surface-200"
														>
															<span class={ "dot", TagTone(tag.Color) }></span>
															<span>{ tag.Name }</span>
														</button>
													}
												</div>
												<template x-if="tags.some(t => t.on)">
													<div class="mt-3 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-2">
														<template x-for="(t, i) in tags" :key="t.id">
															<template x-if="t.on">
																<div class="flex items-center gap-2 rounded-control border border-line-light px-2 py-1.5">
																	<input type="hidden" name="tag_ids[]" :value="t.id"/>
																	<span class="w-1.5 h-1.5 rounded-full shrink-0" :class="['#005bbf','#0070f3','#1484ff'].includes((t.color || '').toLowerCase()) ? 'bg-brand' : 'bg-muted'"></span>
																	<span class="text-sm text-white shrink-0" x-text="t.name"></span>
																	<input
																		type="text"
																		name="tag_values[]"
																		:value="t.val"
																		@input="t.val = $event.target.value"
																		placeholder="value (optional)"
																		:aria-label="'Value for tag ' + t.name"
																		class="form-input h-7 text-xs flex-1 min-w-0"
																	/>
																</div>
															</template>
														</template>
													</div>
												</template>
											</div>
										} else {
											<p class="text-sm text-muted">No tags available.</p>
											if p.Can("tags.create") {
												<a href={ templ.SafeURL(p.BasePath + "/tags") } class="text-white underline underline-offset-2">Create tags</a>
											}
										}
									</div>
								}
								if p.canAssign("proxies") && len(p.Proxies) > 0 {
									<div>
										<label class="form-label" for="proxy_id">Proxy</label>
										<select id="proxy_id" name="proxy_id" class="form-select" aria-describedby="proxy-help proxy-error" :aria-invalid="proxyInvalid" @change="checkProxy($el)" x-effect="monitorType; proxyDNSServer; $nextTick(() => checkProxy($el))">
											<option value="">No proxy</option>
											for _, px := range p.Proxies {
												<option
													value={ fmt.Sprint(px.ID) }
													disabled?={ p.proxyChoiceDisabled(px) }
													:disabled={ proxyChoiceDisabledExpression(px.Protocol) }
													if p.Monitor.ProxyID != nil && *p.Monitor.ProxyID == px.ID {
														selected
													}
												>
													{ fmt.Sprintf("%s (%s://%s:%d)", px.Name, px.Protocol, px.Host, px.Port) }
													if !px.Enabled {
														- disabled; checks fail
													}
												</option>
											}
										</select>
										<p id="proxy-help" class="form-hint">Choose a proxy that supports this check type. DNS through SOCKS5 requires an explicit DNS server. A disabled proxy keeps its assignment, but checks fail until it is enabled. Proxy-routed checks run on the server.</p>
										<p id="proxy-error" x-show="proxyInvalid" x-cloak role="status" class="form-hint text-brand">This proxy cannot run the selected check. Choose a compatible proxy or No proxy.</p>
									</div>
								}
								if p.canAssign("notifications") && len(p.NotificationChannels) > 0 {
									<div>
										<input type="hidden" name="relation_fields" value="notifications"/>
										<div class="form-label">Notification channels</div>
										<p class="form-hint mt-0 mb-2">Leave all unchecked to notify every channel.</p>
										<div class="flex flex-wrap gap-1.5">
											for _, ch := range p.NotificationChannels {
												<label class="inline-flex items-center gap-2 rounded-control border border-line-light px-2 h-8 text-sm cursor-pointer select-none hover:bg-surface-200 has-checked:border-brand has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-brand">
													<input
														type="checkbox"
														name="notification_channel_ids[]"
														value={ fmt.Sprint(ch.ID) }
														if InSlice(ch.ID, p.SelectedChannelIDs) {
															checked
														}
														class="form-checkbox"
													/>
													<span class="text-white">{ ch.Name }</span>
													<span class="text-muted">{ ch.Type }</span>
												</label>
											}
										</div>
									</div>
								}
								if p.canAssign("escalation_policies") && len(p.EscalationPolicies) > 0 {
									<div>
										<label class="form-label" for="escalation_policy_id">Escalation Policy</label>
										<select id="escalation_policy_id" name="escalation_policy_id" class="form-select">
											<option value="">None</option>
											for _, ep := range p.EscalationPolicies {
												<option
													value={ fmt.Sprint(ep.ID) }
													if p.Monitor.EscalationPolicyID != nil && *p.Monitor.EscalationPolicyID == ep.ID {
														selected
													}
												>{ fmt.Sprintf("%s (%d steps)", ep.Name, len(ep.Steps)) }</option>
											}
										</select>
									</div>
								}
								<div>
									<label class="form-label" for="sla_target">SLA Target (%)</label>
									<select id="sla_target" name="sla_target" class="form-select">
										<option
											value="0"
											if p.Monitor.SLATarget == 0 {
												selected
											}
										>None</option>
										<option
											value="99"
											if p.Monitor.SLATarget == 99 {
												selected
											}
										>99%</option>
										<option
											value="99.5"
											if p.Monitor.SLATarget == 99.5 {
												selected
											}
										>99.5%</option>
										<option
											value="99.9"
											if p.Monitor.SLATarget == 99.9 {
												selected
											}
										>99.9%</option>
										<option
											value="99.95"
											if p.Monitor.SLATarget == 99.95 {
												selected
											}
										>99.95%</option>
										<option
											value="99.99"
											if p.Monitor.SLATarget == 99.99 {
												selected
											}
										>99.99%</option>
									</select>
								</div>
								<div>
									<label class="form-label" for="anomaly_sensitivity">Anomaly Detection</label>
									<select id="anomaly_sensitivity" name="anomaly_sensitivity" class="form-select">
										<option
											value="off"
											if p.Monitor.AnomalySensitivity == "" || p.Monitor.AnomalySensitivity == "off" {
												selected
											}
										>Off</option>
										<option
											value="low"
											if p.Monitor.AnomalySensitivity == "low" {
												selected
											}
										>Low (3 sigma)</option>
										<option
											value="medium"
											if p.Monitor.AnomalySensitivity == "medium" {
												selected
											}
										>Medium (2 sigma)</option>
										<option
											value="high"
											if p.Monitor.AnomalySensitivity == "high" {
												selected
											}
										>High (1.5 sigma)</option>
									</select>
									<p class="form-hint">Mark as degraded when response time exceeds the rolling baseline</p>
								</div>
								<div>
									<label class="form-label" for="resend_interval">Resend Notification Interval (s)</label>
									<input id="resend_interval" type="number" name="resend_interval" value={ fmt.Sprint(p.Monitor.ResendInterval) } min="0" placeholder="0 = disabled" class="form-input sm:max-w-[200px] tabular-nums"/>
									<p class="form-hint">Resend notification every N seconds while down (0 = disabled)</p>
								</div>
								<div class="flex items-center flex-wrap gap-5">
									@SettingCheckbox("Track changes", "track_changes", p.Monitor.TrackChanges)
									@SettingCheckbox("Upside-down mode", "upside_down", p.Monitor.UpsideDown)
									if p.canAssign("agents") {
										<input type="hidden" name="relation_fields" value="agents"/>
										@SettingCheckbox("Enable for agents", "agent_enabled", p.Monitor.AgentEnabled)
									}
								</div>
								if p.canAssign("agents") && len(p.Agents) > 0 {
									<div>
										<div class="form-label">Agents</div>
										<p class="form-hint mt-0 mb-2">Select the agents that may run this monitor. No selection means no agent jobs.</p>
										<div class="flex flex-wrap gap-1.5">
											for _, ag := range p.Agents {
												<label class="inline-flex items-center gap-2 rounded-control border border-line-light px-2 h-8 text-sm cursor-pointer select-none hover:bg-surface-200 has-checked:border-brand has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-brand">
													<input
														type="checkbox"
														name="agent_ids[]"
														value={ fmt.Sprint(ag.ID) }
														if InSlice(ag.ID, p.Monitor.AgentIDs) {
															checked
														}
														class="form-checkbox"
													/>
													<span class="text-white">{ ag.Name }</span>
													if ag.Location != "" {
														<span class="text-muted">{ ag.Location }</span>
													}
												</label>
											}
										</div>
									</div>
								}
							</div>
						</div>
					</div>
				</div>
				<div class="form-actions">
					<button type="submit" class="btn-primary">
						if p.Monitor.ID != 0 {
							Save changes
						} else {
							Create monitor
						}
					</button>
					<a
						if p.Monitor.ID != 0 {
							href={ templ.SafeURL(fmt.Sprintf("%s/monitors/%d", p.BasePath, p.Monitor.ID)) }
						}
						else
						if p.HasCapability("monitors.read") {
							href={ templ.SafeURL(p.BasePath + "/monitors") }
						} else {
							href={ templ.SafeURL(p.HomePath()) }
						}
						class="btn-secondary"
					>Cancel</a>
				</div>
			</form>
		</div>
	}
}

templ monitorHTTPSettings(p MonitorFormParams) {
	<fieldset x-show="monitorType === 'http'" :disabled="monitorType !== 'http'" x-cloak class="min-w-0 space-y-4">
		<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
			<div>
				<label class="form-label" for="settings_method">Method</label>
				<select id="settings_method" name="settings_method" x-model="httpMethod" class="form-select">
					<option value="GET">GET</option>
					<option value="POST">POST</option>
					<option value="PUT">PUT</option>
					<option value="PATCH">PATCH</option>
					<option value="DELETE">DELETE</option>
					<option value="HEAD">HEAD</option>
					<option value="OPTIONS">OPTIONS</option>
				</select>
			</div>
			<div>
				<label class="form-label" for="settings_expected_status">Expected Status</label>
				<input
					id="settings_expected_status"
					type="number"
					name="settings_expected_status"
					if p.HTTP.ExpectedStatus != 0 {
						value={ fmt.Sprint(p.HTTP.ExpectedStatus) }
					}
					placeholder="200"
					class="form-input tabular-nums"
				/>
			</div>
		</div>
		<div x-show="httpMethod === 'POST' || httpMethod === 'PUT' || httpMethod === 'PATCH'" x-cloak class="space-y-4">
			<div>
				<label class="form-label" for="settings_body_encoding">Body Encoding</label>
				<select id="settings_body_encoding" name="settings_body_encoding" class="form-select">
					<option value="json" selected?={ p.HTTP.BodyEncoding == "json" }>JSON</option>
					<option value="xml" selected?={ p.HTTP.BodyEncoding == "xml" }>XML</option>
					<option value="form" selected?={ p.HTTP.BodyEncoding == "form" }>Form</option>
					<option value="raw" selected?={ p.HTTP.BodyEncoding == "raw" }>Raw</option>
				</select>
			</div>
			<div>
				<label class="form-label" for="settings_body">Body</label>
				<textarea
					id="settings_body"
					name="settings_body"
					rows="3"
					placeholder="Request body"
					class="form-input font-mono resize-y"
					if p.storedSecret("http", "body") {
						aria-describedby="settings_body-saved"
					}
				>{ p.HTTP.Body }</textarea>
				if p.storedSecret("http", "body") {
					@StoredPayloadControl("settings_body", "body")
				}
			</div>
		</div>
		@HeaderListEditor("httpHeaders", "settings_header_key[]", "settings_header_value[]")
		<div class="space-y-3">
			<div>
				<label class="form-label" for="settings_auth_method">Authentication</label>
				<select id="settings_auth_method" name="settings_auth_method" x-model="authMethod" class="form-select">
					<option value="none">None</option>
					<option value="basic">Basic Auth</option>
					<option value="bearer">Bearer Token</option>
					<option value="oauth2">OAuth2 Client Credentials</option>
				</select>
			</div>
			<div x-show="authMethod === 'basic'" x-cloak class="grid grid-cols-1 sm:grid-cols-2 gap-4">
				@SettingText("Username", "settings_basic_auth_user", p.HTTP.BasicAuthUser, "", "text")
				@SettingPassword("Password", "settings_basic_auth_pass", "basic_auth_pass", p.HTTP.BasicAuthPass, p.storedSecret("http", "basic_auth_pass"), "")
			</div>
			<div x-show="authMethod === 'bearer'" x-cloak>
				@SettingPassword("Token", "settings_bearer_token", "bearer_token", p.HTTP.BearerToken, p.storedSecret("http", "bearer_token"), "")
			</div>
			<div x-show="authMethod === 'oauth2'" x-cloak class="space-y-3">
				@SettingPrivateURL("Token URL", "settings_oauth2_token_url", "oauth2_token_url", p.HTTP.OAuth2TokenURL, "https://auth.example.com/oauth/token", p.storedSecret("http", "oauth2_token_url"))
				<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
					@SettingText("Client ID", "settings_oauth2_client_id", p.HTTP.OAuth2ClientID, "", "text")
					@SettingPassword("Client Secret", "settings_oauth2_client_secret", "oauth2_client_secret", p.HTTP.OAuth2ClientSecret, p.storedSecret("http", "oauth2_client_secret"), "")
				</div>
				<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
					<div>
						<label class="form-label" for="settings_oauth2_scopes">Scopes <span class="text-muted font-normal">(optional)</span></label>
						<input id="settings_oauth2_scopes" type="text" name="settings_oauth2_scopes" value={ p.HTTP.OAuth2Scopes } placeholder="read write" class="form-input"/>
					</div>
					<div>
						<label class="form-label" for="settings_oauth2_audience">Audience <span class="text-muted font-normal">(optional)</span></label>
						<input id="settings_oauth2_audience" type="text" name="settings_oauth2_audience" value={ p.HTTP.OAuth2Audience } placeholder="https://api.example.com" class="form-input"/>
					</div>
				</div>
			</div>
		</div>
		<div class="space-y-3">
			<label class="flex items-center gap-2 cursor-pointer">
				<input
					type="checkbox"
					name="settings_mtls_enabled"
					x-model="mtlsEnabled"
					if p.HTTP.MTLSEnabled {
						checked
					}
					class="form-checkbox"
				/>
				<span class="text-sm text-muted-light">Mutual TLS (mTLS)</span>
			</label>
			<div x-show="mtlsEnabled" x-cloak class="space-y-3">
				<div>
					<label class="form-label" for="settings_mtls_client_cert">Client Certificate <span class="text-muted font-normal">(PEM)</span></label>
					<textarea id="settings_mtls_client_cert" name="settings_mtls_client_cert" rows="4" placeholder="-----BEGIN CERTIFICATE-----" class="form-input font-mono text-xs resize-y">{ p.HTTP.MTLSClientCert }</textarea>
				</div>
				<div>
					<label class="form-label" for="settings_mtls_client_key">Client Key <span class="text-muted font-normal">(PEM)</span></label>
					<textarea
						id="settings_mtls_client_key"
						name="settings_mtls_client_key"
						rows="4"
						if p.storedSecret("http", "mtls_client_key") && p.HTTP.MTLSClientKey == "" {
							placeholder="Saved. Leave blank to keep it."
						} else {
							placeholder="-----BEGIN PRIVATE KEY-----"
						}
						class="form-input font-mono text-xs resize-y"
					>{ p.HTTP.MTLSClientKey }</textarea>
					if p.storedSecret("http", "mtls_client_key") {
						@ClearSecretCheckbox("mtls_client_key")
					}
				</div>
				<div>
					<label class="form-label" for="settings_mtls_ca_cert">CA Certificate <span class="text-muted font-normal">(optional, PEM)</span></label>
					<textarea id="settings_mtls_ca_cert" name="settings_mtls_ca_cert" rows="3" placeholder="-----BEGIN CERTIFICATE-----" class="form-input font-mono text-xs resize-y">{ p.HTTP.MTLSCACert }</textarea>
					<p class="form-hint">Custom CA for self-signed server certificates</p>
				</div>
			</div>
		</div>
		<div>
			<label class="form-label" for="settings_max_redirects">Max Redirects</label>
			<input id="settings_max_redirects" type="number" name="settings_max_redirects" value={ fmt.Sprint(p.MaxRedirects) } min="0" max="30" class="form-input sm:max-w-[200px] tabular-nums"/>
			<p class="form-hint">0 = don't follow redirects</p>
		</div>
		<div class="flex items-center flex-wrap gap-5">
			@SettingCheckbox("Ignore TLS/SSL errors", "settings_skip_tls_verify", p.HTTP.SkipTLSVerify)
			@SettingCheckbox("Cache buster", "settings_cache_buster", p.HTTP.CacheBuster)
		</div>
	</fieldset>
}

templ monitorTCPSettings(p MonitorFormParams) {
	<fieldset x-show="monitorType === 'tcp'" :disabled="monitorType !== 'tcp'" x-cloak class="min-w-0 space-y-4">
		@SettingPrivateText("Send Data", "settings_send_data", "send_data", p.TCP.SendData, "Optional data to send", p.storedSecret("tcp", "send_data"))
		@SettingPrivateText("Expect Data", "settings_expect_data", "expect_data", p.TCP.ExpectData, "Expected response", p.storedSecret("tcp", "expect_data"))
	</fieldset>
}

templ monitorDNSSettings(p MonitorFormParams) {
	<fieldset x-show="monitorType === 'dns'" :disabled="monitorType !== 'dns'" x-cloak class="min-w-0 space-y-4">
		<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
			<div>
				<label class="form-label" for="settings_record_type">Record Type</label>
				<select id="settings_record_type" name="settings_record_type" class="form-select">
					<option value="A" selected?={ p.DNS.RecordType == "A" }>A</option>
					<option value="AAAA" selected?={ p.DNS.RecordType == "AAAA" }>AAAA</option>
					<option value="CNAME" selected?={ p.DNS.RecordType == "CNAME" }>CNAME</option>
					<option value="MX" selected?={ p.DNS.RecordType == "MX" }>MX</option>
					<option value="TXT" selected?={ p.DNS.RecordType == "TXT" }>TXT</option>
					<option value="NS" selected?={ p.DNS.RecordType == "NS" }>NS</option>
					<option value="SOA" selected?={ p.DNS.RecordType == "SOA" }>SOA</option>
				</select>
			</div>
			<div>
				<label class="form-label" for="settings_dns_server">DNS Server</label>
				<input id="settings_dns_server" type="text" name="settings_dns_server" value={ p.DNS.Server } x-model="dnsServer" placeholder="Optional (e.g. 8.8.8.8)" class="form-input"/>
			</div>
		</div>
	</fieldset>
}

templ monitorTLSSettings(p MonitorFormParams) {
	<fieldset x-show="monitorType === 'tls'" :disabled="monitorType !== 'tls'" x-cloak class="min-w-0 space-y-4">
		@SettingNumber("Warning Days Before Expiry", "settings_warn_days_before", intOrDefault(p.TLS.WarnDaysBefore, 30), "", "1", "365", "sm:max-w-[200px]")
	</fieldset>
}

templ monitorWSSettings(p MonitorFormParams) {
	<fieldset x-show="monitorType === 'websocket'" :disabled="monitorType !== 'websocket'" x-cloak class="min-w-0 space-y-4">
		@HeaderListEditor("wsHeaders", "settings_ws_header_key[]", "settings_ws_header_value[]")
		@SettingPrivateText("Send Message", "settings_send_message", "send_message", p.WS.SendMessage, "Optional message to send", p.storedSecret("websocket", "send_message"))
		@SettingPrivateText("Expect Reply", "settings_expect_reply", "expect_reply", p.WS.ExpectReply, "Expected reply", p.storedSecret("websocket", "expect_reply"))
	</fieldset>
}

templ monitorCommandSettings(p MonitorFormParams) {
	<fieldset x-show="monitorType === 'command'" :disabled="monitorType !== 'command'" x-cloak class="min-w-0 space-y-4">
		@SettingText("Command", "settings_command", p.Cmd.Command, "/usr/bin/check-health", "text")
		<div>
			@SettingPrivateText("Arguments", "settings_args", "args", p.cmdArgsStr(), "--verbose, --timeout=5", p.storedSecret("command", "args"))
			<p class="form-hint">Comma-separated</p>
		</div>
	</fieldset>
}

templ monitorDockerSettings(p MonitorFormParams) {
	<fieldset x-show="monitorType === 'docker'" :disabled="monitorType !== 'docker'" x-cloak class="min-w-0 space-y-4">
		<div>
			<label class="form-label" for="settings_container_name">Container Name / ID</label>
			<input id="settings_container_name" type="text" name="settings_container_name" value={ p.Docker.ContainerName } placeholder="my-container or abc123def" class="form-input"/>
			<p class="form-hint">Overrides target if set</p>
		</div>
		<div>
			<label class="form-label" for="settings_socket_path">Docker Socket Path</label>
			<input id="settings_socket_path" type="text" name="settings_socket_path" value={ p.Docker.SocketPath } placeholder="/var/run/docker.sock" class="form-input"/>
			<p class="form-hint">Default: /var/run/docker.sock</p>
		</div>
		<div class="flex items-center flex-wrap gap-5">
			@SettingCheckbox("Check container health status", "settings_check_health", p.Docker.CheckHealth)
		</div>
	</fieldset>
}

templ monitorDomainSettings(p MonitorFormParams) {
	<fieldset x-show="monitorType === 'domain'" :disabled="monitorType !== 'domain'" x-cloak class="min-w-0 space-y-4">
		<div>
			<label class="form-label" for="settings_domain_warn_days">Warning Days Before Expiry</label>
			<input id="settings_domain_warn_days" type="number" name="settings_domain_warn_days" value={ intOrDefault(p.Domain.WarnDaysBefore, 30) } min="1" max="365" class="form-input sm:max-w-[200px] tabular-nums"/>
			<p class="form-hint">Mark as degraded when domain expires within this many days</p>
		</div>
	</fieldset>
}

templ monitorGRPCSettings(p MonitorFormParams) {
	<fieldset x-show="monitorType === 'grpc'" :disabled="monitorType !== 'grpc'" x-cloak class="min-w-0 space-y-4">
		<div>
			<label class="form-label" for="settings_grpc_service">Service Name</label>
			<input id="settings_grpc_service" type="text" name="settings_grpc_service" value={ p.GRPC.ServiceName } placeholder="Leave empty for overall health" class="form-input"/>
			<p class="form-hint">gRPC service to check (empty = all services)</p>
		</div>
		<div class="flex items-center flex-wrap gap-5">
			@SettingCheckbox("Use TLS", "settings_grpc_tls", p.GRPC.UseTLS)
			@SettingCheckbox("Skip TLS verification", "settings_grpc_skip_verify", p.GRPC.SkipTLSVerify)
		</div>
	</fieldset>
}

templ monitorMQTTSettings(p MonitorFormParams) {
	<fieldset x-show="monitorType === 'mqtt'" :disabled="monitorType !== 'mqtt'" x-cloak class="min-w-0 space-y-4">
		<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
			@SettingText("Client ID", "settings_mqtt_client_id", p.MQTT.ClientID, "asura-monitor", "text")
			@SettingText("Topic", "settings_mqtt_topic", p.MQTT.Topic, "Optional subscribe topic", "text")
		</div>
		<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
			@SettingText("Username", "settings_mqtt_username", p.MQTT.Username, "Optional", "text")
			@SettingPassword("Password", "settings_mqtt_password", "password", p.MQTT.Password, p.storedSecret("mqtt", "password"), "Optional")
		</div>
		@SettingPrivateText("Expected Message", "settings_mqtt_expect", "expect_message", p.MQTT.ExpectMessage, "Optional message content to expect", p.storedSecret("mqtt", "expect_message"))
		<div class="flex items-center flex-wrap gap-5">
			@SettingCheckbox("Use TLS", "settings_mqtt_tls", p.MQTT.UseTLS)
		</div>
	</fieldset>
}

templ monitorAssertions(p MonitorFormParams) {
	<div class="card card-pad">
		<div class="flex items-center justify-between mb-4">
			<h2 class="text-lg font-semibold">Conditions</h2>
			<button type="button" x-show="conditions.groups.length > 0 || advancedAssertions" @click="advancedAssertions = !advancedAssertions" class="btn-secondary btn-sm">
				<span x-text="advancedAssertions ? 'Use form' : 'Edit as JSON'">Edit as JSON</span>
			</button>
		</div>
		<input type="hidden" name="assertions_mode" :value="advancedAssertions ? 'json' : 'form'"/>
		<div x-show="advancedAssertions" x-cloak>
			<label class="sr-only" for="assertions_json">Conditions (JSON)</label>
			<textarea id="assertions_json" name="assertions_json" rows="8" placeholder="{}" class="form-input font-mono text-xs resize-y">{ p.AssertionsRaw }</textarea>
		</div>
		<div x-show="!advancedAssertions">
			<input type="hidden" name="group_count" :value="conditions.groups.length"/>
			<input type="hidden" name="condition_set_operator" :value="conditions.operator"/>
			<div x-show="conditions.groups.length === 0" class="flex flex-wrap items-center justify-between gap-3">
				<p class="text-sm text-muted">No conditions. The check passes when the target responds successfully.</p>
				<button type="button" @click="addGroup()" class="btn-secondary btn-sm">Add condition group</button>
			</div>
			<div class="space-y-1">
				<template x-for="(g, gi) in conditions.groups" :key="gi">
					<div>
						<!-- AND/OR connector between groups -->
						<div x-show="gi > 0" class="flex items-center gap-2 my-2">
							<div class="flex-1 border-t border-line"></div>
							<select x-model="conditions.operator" aria-label="Combine groups with" class="form-select-sm h-7 w-24">
								<option value="and">AND</option>
								<option value="or">OR</option>
							</select>
							<div class="flex-1 border-t border-line"></div>
						</div>
						<!-- Per-group hidden structural inputs -->
						<input type="hidden" :name="'group_' + gi + '_operator'" :value="g.operator"/>
						<input type="hidden" :name="'group_' + gi + '_count'" :value="g.conditions.length"/>
						<div class="panel overflow-hidden">
							<div class="flex items-center justify-between px-3 py-2 border-b border-line">
								<div class="flex items-center gap-2">
									<span class="text-sm text-muted">Match</span>
									<select x-model="g.operator" aria-label="Group match mode" class="form-select-sm h-7 w-24">
										<option value="and">ALL</option>
										<option value="or">ANY</option>
									</select>
									<span class="text-sm text-muted">of these conditions</span>
								</div>
								<button type="button" @click="conditions.groups.splice(gi, 1)" class="row-action hover:text-crit" title="Remove group" aria-label="Remove group">
									<svg focusable="false" aria-hidden="true" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
								</button>
							</div>
							<div class="p-3 space-y-2">
								<template x-for="(c, ci) in g.conditions" :key="ci">
									<div class="flex items-start gap-2">
										<div class="flex-1 grid grid-cols-1 sm:grid-cols-2 gap-2">
											<select :name="'group_' + gi + '_type_' + ci" x-model="c.type" aria-label="Condition" class="form-select h-8">
												<option value="status_code">Status Code</option>
												<option value="body_contains">Body Contains</option>
												<option value="body_regex">Body Regex</option>
												<option value="json_path">JSON Path</option>
												<option value="header">Header</option>
												<option value="response_time">Response Time (ms)</option>
												<option value="cert_expiry">Cert Expiry (days)</option>
												<option value="dns_record">DNS Record</option>
											</select>
											<select :name="'group_' + gi + '_operator_' + ci" x-model="c.operator" aria-label="Operator" class="form-select h-8">
												<template x-for="op in operatorsFor(c.type)" :key="op[0]">
													<option :value="op[0]" x-text="op[1]"></option>
												</template>
											</select>
											<div x-show="needsTarget(c.type)">
												<input type="text" :name="'group_' + gi + '_target_' + ci" x-model="c.target" placeholder="Header name or JSON path" aria-label="Header name or JSON path" class="form-input h-8"/>
											</div>
											<div x-show="needsValue(c.operator)" :class="needsTarget(c.type) ? '' : 'col-span-2'">
												<input type="text" :name="'group_' + gi + '_value_' + ci" x-model="c.value" placeholder="Expected value" aria-label="Expected value" class="form-input h-8"/>
											</div>
										</div>
										<div class="flex items-center gap-2 pt-1.5 shrink-0">
											<label class="flex items-center gap-1 cursor-pointer" title="Mark the monitor degraded instead of down when this fails">
												<input type="checkbox" :name="'group_' + gi + '_degraded_' + ci" value="on" :checked="c.degraded" @change="c.degraded = $event.target.checked" class="form-checkbox"/>
												<span class="text-sm text-muted">Degrade only</span>
											</label>
											<button type="button" @click="g.conditions.splice(ci, 1)" class="row-action hover:text-crit" title="Remove condition" aria-label="Remove condition">
												<svg focusable="false" aria-hidden="true" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
											</button>
										</div>
									</div>
								</template>
								<button type="button" @click="g.conditions.push(newCond())" class="btn-secondary btn-sm">Add condition</button>
							</div>
						</div>
					</div>
				</template>
			</div>
			<button type="button" x-show="conditions.groups.length > 0" @click="addGroup()" class="btn-secondary btn-sm mt-3">Add condition group</button>
		</div>
	</div>
}

templ monitorSMTPSettings(p MonitorFormParams) {
	<fieldset x-show="monitorType === 'smtp'" :disabled="monitorType !== 'smtp'" x-cloak class="min-w-0 space-y-4">
		<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
			<div>
				<label class="form-label" for="settings_smtp_port">Port</label>
				<input
					id="settings_smtp_port"
					type="number"
					name="settings_smtp_port"
					if p.SMTP.Port != 0 {
						value={ fmt.Sprint(p.SMTP.Port) }
					}
					placeholder="25"
					min="1"
					max="65535"
					class="form-input tabular-nums"
				/>
				<p class="form-hint">25 (plain), 465 (SMTPS), 587 (submission)</p>
			</div>
			<div>
				@SettingPrivateText("Expected Banner", "settings_smtp_expect_banner", "expect_banner", p.SMTP.ExpectBanner, "Optional", p.storedSecret("smtp", "expect_banner"))
			</div>
		</div>
		@SettingCheckbox("Require STARTTLS", "settings_smtp_starttls", p.SMTP.STARTTLS)
	</fieldset>
}

templ monitorSSHSettings(p MonitorFormParams) {
	<fieldset x-show="monitorType === 'ssh'" :disabled="monitorType !== 'ssh'" x-cloak class="min-w-0 space-y-4">
		<div>
			<label class="form-label" for="settings_ssh_fingerprint">Expected Banner Fingerprint (SHA-256)</label>
			<input id="settings_ssh_fingerprint" type="text" name="settings_ssh_fingerprint" value={ p.SSH.ExpectedFingerprint } placeholder="Optional SHA-256 hex fingerprint" class="form-input font-mono"/>
			<p class="form-hint">Hashes the SSH identification banner, not the host key — this is not MITM/host-identity verification. Leave empty to skip.</p>
		</div>
	</fieldset>
}

templ monitorRedisSettings(p MonitorFormParams) {
	<fieldset x-show="monitorType === 'redis'" :disabled="monitorType !== 'redis'" x-cloak class="min-w-0 space-y-4">
		@SettingPassword("Password", "settings_redis_password", "password", p.Redis.Password, p.storedSecret("redis", "password"), "Optional")
	</fieldset>
}

templ monitorPostgreSQLSettings(p MonitorFormParams) {
	<fieldset x-show="monitorType === 'postgresql'" :disabled="monitorType !== 'postgresql'" x-cloak class="min-w-0 space-y-4">
		<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
			@SettingText("Username", "settings_pg_username", p.PostgreSQL.Username, "postgres", "text")
			@SettingText("Database", "settings_pg_database", p.PostgreSQL.Database, "postgres", "text")
		</div>
		<p class="form-hint">Checks if PostgreSQL accepts connections (startup handshake). No authentication performed.</p>
	</fieldset>
}

templ monitorUDPSettings(p MonitorFormParams) {
	<fieldset x-show="monitorType === 'udp'" :disabled="monitorType !== 'udp'" x-cloak class="min-w-0 space-y-4">
		@SettingPrivateText("Send Data", "settings_udp_send", "send_data", p.UDP.SendData, "Data to send", p.storedSecret("udp", "send_data"))
		@SettingPrivateText("Expect Data", "settings_udp_expect", "expect_data", p.UDP.ExpectData, "Expected in response (optional)", p.storedSecret("udp", "expect_data"))
	</fieldset>
}
