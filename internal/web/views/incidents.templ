package views

import (
	"fmt"
	"net/url"
	"strconv"

	"github.com/y0f/asura/internal/storage"
)

type IncidentListParams struct {
	LayoutParams
	Result *storage.PaginatedResult
	Filter string
	Search string
}

type IncidentDetailParams struct {
	LayoutParams
	Incident *storage.Incident
	Events   []*storage.IncidentEvent
}

func (p IncidentListParams) incidents() []*storage.Incident {
	if p.Result == nil || p.Result.Data == nil {
		return nil
	}
	incs, _ := p.Result.Data.([]*storage.Incident)
	return incs
}

func (p IncidentListParams) filterHref(status string) string {
	q := url.Values{}
	if status != "" {
		q.Set("status", status)
	}
	if p.Search != "" {
		q.Set("q", p.Search)
	}
	if len(q) == 0 {
		return p.BasePath + "/incidents"
	}
	return p.BasePath + "/incidents?" + q.Encode()
}

func (p IncidentListParams) pageHref(page int) string {
	q := url.Values{}
	q.Set("page", strconv.Itoa(page))
	if p.Filter != "" {
		q.Set("status", p.Filter)
	}
	if p.Search != "" {
		q.Set("q", p.Search)
	}
	return p.BasePath + "/incidents?" + q.Encode()
}

templ IncidentListPage(p IncidentListParams) {
	@Layout(p.LayoutParams) {
		@PageHeader(PageHeaderParams{Title: "Incidents", Subtitle: "Opened automatically when a monitor fails, closed when it recovers."})
		<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-4">
			<nav class="flex flex-wrap gap-1" aria-label="Filter by status">
				<a href={ templ.SafeURL(p.filterHref("")) }
					if p.Filter == "" {
						aria-current="page"
					}
					class={ "filter-tab", templ.KV("filter-active", p.Filter == ""), templ.KV("filter-inactive", p.Filter != "") }>All</a>
				for _, st := range []string{"open", "acknowledged", "resolved"} {
					<a href={ templ.SafeURL(p.filterHref(st)) }
						if p.Filter == st {
							aria-current="page"
						}
						class={ "filter-tab", templ.KV("filter-active", p.Filter == st), templ.KV("filter-inactive", p.Filter != st) }>{ StatusLabel(st) }</a>
				}
			</nav>
			<form method="GET" action={ templ.SafeURL(p.BasePath + "/incidents") }>
				if p.Filter != "" {
					<input type="hidden" name="status" value={ p.Filter }/>
				}
				@SearchInput("q", p.Search, "Search incidents")
			</form>
		</div>
		if incs := p.incidents(); len(incs) > 0 {
			<div class="panel">
				<div class="overflow-x-auto">
					<table class="w-full md:min-w-[760px]">
						<thead>
							<tr class="border-b border-line">
								<th class="th">Monitor</th>
								<th class="th w-px">Status</th>
								<th class="th w-px hidden md:table-cell">Severity</th>
								<th class="th hidden md:table-cell">Cause</th>
								<th class="th w-px hidden sm:table-cell">Duration</th>
								<th class="th w-px">Started</th>
								<th class="th w-px"><span class="sr-only">Actions</span></th>
							</tr>
						</thead>
						<tbody class="divide-y divide-line">
							for _, inc := range incs {
								<tr>
									<td class="px-4 py-3">
										<a href={ templ.SafeURL(fmt.Sprintf("%s/incidents/%d", p.BasePath, inc.ID)) } class="text-sm text-white font-medium hover:underline whitespace-nowrap">{ inc.MonitorName }</a>
									</td>
									<td class="px-4 py-3">@StatusPill(inc.Status)</td>
									<td class="px-4 py-3 hidden md:table-cell">@SeverityPill(inc.Severity)</td>
									<td class="px-4 py-3 text-sm text-muted max-w-0 w-full truncate hidden md:table-cell" title={ inc.Cause }>{ inc.Cause }</td>
									<td class="px-4 py-3 text-sm text-muted-light tabular-nums whitespace-nowrap hidden sm:table-cell">{ IncidentDuration(inc.StartedAt, inc.ResolvedAt) }</td>
									<td class="px-4 py-3 text-sm text-muted whitespace-nowrap">@RelTime(inc.StartedAt)</td>
									<td class="px-4 py-3 text-right">
										if p.Can("incidents.write") {
											@DeleteButton(fmt.Sprintf("%s/incidents/%d/delete", p.BasePath, inc.ID), "Delete this incident and its timeline?")
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
				if p.Result != nil && p.Result.TotalPages > 1 {
					@Pager(p.Result.Page, p.Result.TotalPages, fmt.Sprintf("Page %d of %d · %d incidents", p.Result.Page, p.Result.TotalPages, p.Result.Total), p.pageHref(p.Result.Page-1), p.pageHref(p.Result.Page+1))
				} else if p.Result != nil {
					<div class="px-4 py-2.5 border-t border-line text-xs text-muted tabular-nums">{ fmt.Sprintf("%d incidents", p.Result.Total) }</div>
				}
			</div>
		} else if p.Search != "" || p.Filter != "" {
			@EmptyState("No incidents match these filters.", p.BasePath+"/incidents", "Clear filters")
		} else {
			@EmptyState("No incidents so far.", "", "")
		}
	}
}

func (p IncidentDetailParams) subtitle() string {
	return fmt.Sprintf("Started %s · lasted %s", TimeAgo(p.Incident.StartedAt), IncidentDuration(p.Incident.StartedAt, p.Incident.ResolvedAt))
}

templ IncidentDetailPage(p IncidentDetailParams) {
	@Layout(p.LayoutParams) {
		@PageHeader(PageHeaderParams{Title: p.Incident.MonitorName, Subtitle: p.subtitle(), BackHref: p.BasePath + "/incidents", BackLabel: "Incidents"}) {
			@StatusPill(p.Incident.Status)
			@SeverityPill(p.Incident.Severity)
			if p.Can("incidents.write") {
				<div class="flex flex-wrap items-center gap-2 sm:ml-auto">
					if p.Incident.Status == "open" {
						<form method="POST" action={ templ.SafeURL(fmt.Sprintf("%s/incidents/%d/ack", p.BasePath, p.Incident.ID)) }>
							<button type="submit" class="btn-secondary">Acknowledge</button>
						</form>
					}
					if p.Incident.Status != "resolved" {
						<form method="POST" action={ templ.SafeURL(fmt.Sprintf("%s/incidents/%d/resolve", p.BasePath, p.Incident.ID)) }>
							<button type="submit" class="btn-primary">Resolve</button>
						</form>
					}
					<button type="button"
						data-url={ fmt.Sprintf("%s/incidents/%d/delete", p.BasePath, p.Incident.ID) }
						data-msg="Delete this incident and its timeline?"
						@click="$dispatch('confirm',{url:$el.dataset.url,message:$el.dataset.msg})"
						class="btn-danger">Delete</button>
				</div>
			}
		}
		<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
			<section class="card card-pad" aria-labelledby="inc-cause">
				<h2 id="inc-cause" class="text-md font-semibold mb-2">Cause</h2>
				<p class="text-sm text-white break-words">{ p.Incident.Cause }</p>
				<dl class="mt-4 text-sm">
					<div class="flex justify-between gap-4 py-2 border-t border-line"><dt class="text-muted">Incident</dt><dd class="text-white tabular-nums">{ fmt.Sprintf("#%d", p.Incident.ID) }</dd></div>
					<div class="flex justify-between gap-4 py-2 border-t border-line"><dt class="text-muted">Started</dt><dd class="text-white">@RelTime(p.Incident.StartedAt)</dd></div>
					if p.Incident.ResolvedAt != nil {
						<div class="flex justify-between gap-4 py-2 border-t border-line"><dt class="text-muted">Resolved</dt><dd class="text-white">@RelTime(p.Incident.ResolvedAt)</dd></div>
					}
					<div class="flex justify-between gap-4 py-2 border-t border-line">
						<dt class="text-muted">Monitor</dt>
						<dd><a href={ templ.SafeURL(fmt.Sprintf("%s/monitors/%d", p.BasePath, p.Incident.MonitorID)) } class="text-white hover:underline">{ p.Incident.MonitorName }</a></dd>
					</div>
				</dl>
			</section>
			<section class="lg:col-span-2 panel" aria-labelledby="inc-timeline">
				<div class="px-4 py-3 border-b border-line">
					<h2 id="inc-timeline" class="text-md font-semibold">Timeline</h2>
				</div>
				if len(p.Events) > 0 {
					<ol class="p-4">
						for _, ev := range p.Events {
							<li class="flex gap-3">
								<div class="flex flex-col items-center">
									<span class={ "dot mt-1.5", StatusDot(ev.Type) }></span>
									<span class="w-px flex-1 bg-line mt-1"></span>
								</div>
								<div class="pb-4 min-w-0">
									<div class="text-sm text-white break-words">{ ev.Message }</div>
									<div class="text-xs text-muted mt-0.5">@RelTime(ev.CreatedAt)</div>
								</div>
							</li>
						}
					</ol>
				} else {
					<div class="px-4 py-10 text-center text-sm text-muted">No events yet.</div>
				}
			</section>
		</div>
	}
}
