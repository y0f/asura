package views

import (
	"fmt"
	"net/url"
	"strconv"
	"strings"

	"github.com/y0f/asura/internal/storage"
)

type AuditLogParams struct {
	LayoutParams
	Result    *storage.PaginatedResult
	Filter    storage.AuditLogFilter
	TimeRange string
}

func (p AuditLogParams) entries() []*storage.AuditEntry {
	if p.Result == nil || p.Result.Data == nil {
		return nil
	}
	entries, _ := p.Result.Data.([]*storage.AuditEntry)
	return entries
}

func (p AuditLogParams) href(timeRange, action, entity string, page int) string {
	q := url.Values{}
	q.Set("range", timeRange)
	if action != "" {
		q.Set("action", action)
	}
	if entity != "" {
		q.Set("entity", entity)
	}
	if p.Filter.APIKeyName != "" {
		q.Set("api_key", p.Filter.APIKeyName)
	}
	if page > 1 {
		q.Set("page", strconv.Itoa(page))
	}
	return p.BasePath + "/audit?" + q.Encode()
}

var auditActions = []string{"create", "update", "delete", "pause", "resume", "clone", "set_status", "acknowledge", "resolve", "set_severity", "toggle", "export", "import", "login_success", "login_failed", "logout"}

var auditEntities = []string{"monitor", "monitor_group", "tag", "incident", "notification_channel", "escalation_policy", "on_call_rotation", "maintenance_window", "status_page", "subscriber", "proxy", "agent", "config", "session"}

func humanize(s string) string {
	return capitalize(strings.ReplaceAll(s, "_", " "))
}

// auditBadgeVariant maps an audit action to a shared .badge-* variant by semantic
// group (create/positive, destroy, mutate, auth-success, auth-failure, neutral) so
// every action - including high-frequency ones like login_success/logout - gets an
// intentional color instead of falling through to an un-themed default.
func auditBadgeVariant(action string) string {
	switch action {
	case "create", "clone", "resume", "resolve", "import", "login_success":
		return "badge-emerald"
	case "delete", "login_failed":
		return "badge-red"
	case "update", "export":
		return "badge-blue"
	case "pause", "acknowledge":
		return "badge-yellow"
	case "logout":
		return "badge-zinc"
	default:
		return "badge-zinc"
	}
}

templ AuditLogPage(p AuditLogParams) {
	@Layout(p.LayoutParams) {
		@PageHeader(PageHeaderParams{Title: "Audit Log", Subtitle: "Who changed what, and when."})
		<div class="flex flex-wrap items-center gap-x-4 gap-y-2 mb-4">
			<nav class="flex gap-1" aria-label="Time range">
				for _, tr := range []string{"24h", "7d", "30d"} {
					<a href={ templ.SafeURL(p.href(tr, p.Filter.Action, p.Filter.Entity, 1)) }
						class={ "filter-tab", templ.KV("filter-active", p.TimeRange == tr), templ.KV("filter-inactive", p.TimeRange != tr) }>{ tr }</a>
				}
			</nav>
			<form method="GET" action={ templ.SafeURL(p.BasePath + "/audit") } class="flex flex-wrap items-center gap-2">
				<input type="hidden" name="range" value={ p.TimeRange }/>
				<select name="action" onchange="this.form.submit()" class="form-select-sm" aria-label="Action">
					<option value="">All actions</option>
					for _, a := range auditActions {
						<option value={ a } selected?={ p.Filter.Action == a }>{ humanize(a) }</option>
					}
				</select>
				<select name="entity" onchange="this.form.submit()" class="form-select-sm" aria-label="Entity">
					<option value="">All entities</option>
					for _, e := range auditEntities {
						<option value={ e } selected?={ p.Filter.Entity == e }>{ humanize(e) }</option>
					}
				</select>
				<noscript><button type="submit" class="btn-secondary btn-sm">Apply</button></noscript>
			</form>
			if p.Filter.Action != "" || p.Filter.Entity != "" {
				<a href={ templ.SafeURL(p.href(p.TimeRange, "", "", 1)) } class="text-sm text-muted hover:text-white">Clear</a>
			}
			if p.Result != nil {
				<span class="text-sm text-muted ml-auto tabular-nums">{ fmt.Sprintf("%d entries", p.Result.Total) }</span>
			}
		</div>
		if entries := p.entries(); len(entries) > 0 {
			<div class="panel">
				<div class="overflow-x-auto">
					<table class="w-full min-w-[680px]">
						<thead>
							<tr class="border-b border-line">
								<th class="th">Time</th>
								<th class="th">Action</th>
								<th class="th">Entity</th>
								<th class="th">Key</th>
								<th class="th">Detail</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-line">
							for _, e := range entries {
								<tr>
									<td class="px-4 py-2.5 text-sm text-muted whitespace-nowrap">@RelTime(e.CreatedAt)</td>
									<td class="px-4 py-2.5"><span class={ "badge", auditBadgeVariant(e.Action) }>{ humanize(e.Action) }</span></td>
									<td class="px-4 py-2.5 text-sm text-muted-light whitespace-nowrap">
										{ humanize(e.Entity) }
										if e.EntityID > 0 {
											<span class="text-muted tabular-nums">{ fmt.Sprintf("#%d", e.EntityID) }</span>
										}
									</td>
									<td class="px-4 py-2.5 text-sm text-muted-light">
										if e.APIKeyName != "" {
											{ e.APIKeyName }
										} else {
											<span class="text-muted">—</span>
										}
									</td>
									<td class="px-4 py-2.5 text-sm text-muted">
										if e.Detail != "" {
											<span class="block truncate max-w-[320px]" title={ e.Detail }>{ e.Detail }</span>
										} else {
											—
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
				if p.Result != nil && p.Result.TotalPages > 1 {
					@Pager(p.Result.Page, p.Result.TotalPages, fmt.Sprintf("Page %d of %d", p.Result.Page, p.Result.TotalPages), p.href(p.TimeRange, p.Filter.Action, p.Filter.Entity, p.Result.Page-1), p.href(p.TimeRange, p.Filter.Action, p.Filter.Entity, p.Result.Page+1))
				}
			</div>
		} else {
			@EmptyState("No audit entries in this range.", "", "")
		}
	}
}
