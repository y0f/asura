package views

import (
	"fmt"
	"net/url"
	"strconv"
	"unicode"
	"unicode/utf8"

	"github.com/y0f/asura/internal/storage"
)

type RequestLogParams struct {
	LayoutParams
	Result    *storage.PaginatedResult
	Stats     *storage.RequestLogStats
	Filter    string
	ClientIP  string
	TimeRange string
	TopIPs    []string
}

func (p RequestLogParams) logs() []*storage.RequestLog {
	if p.Result == nil || p.Result.Data == nil {
		return nil
	}
	logs, _ := p.Result.Data.([]*storage.RequestLog)
	return logs
}

// href builds a logs URL from the current filters with the given overrides,
// escaping every value.
func (p RequestLogParams) href(timeRange, group, ip string, page int) string {
	q := url.Values{}
	q.Set("range", timeRange)
	if group != "" {
		q.Set("group", group)
	}
	if ip != "" {
		q.Set("ip", ip)
	}
	if page > 1 {
		q.Set("page", strconv.Itoa(page))
	}
	return p.BasePath + "/logs?" + q.Encode()
}

templ RequestLogListPage(p RequestLogParams) {
	@Layout(p.LayoutParams) {
		@PageHeader(PageHeaderParams{Title: "Request Logs", Subtitle: "HTTP requests served by Asura: the UI, API, badges and status pages."})
		if p.Stats != nil {
			<div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-6">
				@StatCard("Requests", fmt.Sprint(p.Stats.TotalRequests), "")
				@StatCard("Unique visitors", fmt.Sprint(p.Stats.UniqueVisitors), "")
				@StatCard("Average latency", FormatMs(p.Stats.AvgLatencyMs), "")
			</div>
		}
		<div class="flex flex-wrap items-center gap-x-4 gap-y-2 mb-4">
			<nav class="flex flex-wrap gap-1" aria-label="Time range">
				for _, tr := range []string{"1h", "12h", "24h", "7d"} {
					<a href={ templ.SafeURL(p.href(tr, p.Filter, p.ClientIP, 1)) }
						class={ "filter-tab", templ.KV("filter-active", p.TimeRange == tr), templ.KV("filter-inactive", p.TimeRange != tr) }>{ tr }</a>
				}
			</nav>
			<nav class="flex flex-wrap gap-1" aria-label="Route group">
				<a href={ templ.SafeURL(p.href(p.TimeRange, "", p.ClientIP, 1)) }
					class={ "filter-tab", templ.KV("filter-active", p.Filter == ""), templ.KV("filter-inactive", p.Filter != "") }>All</a>
				for _, g := range []string{"web", "api", "badge", "auth", "status"} {
					<a href={ templ.SafeURL(p.href(p.TimeRange, g, p.ClientIP, 1)) }
						class={ "filter-tab", templ.KV("filter-active", p.Filter == g), templ.KV("filter-inactive", p.Filter != g) }>{ routeGroupLabel(g) }</a>
				}
			</nav>
			if len(p.TopIPs) > 0 {
				<form method="GET" action={ templ.SafeURL(p.BasePath + "/logs") }>
					<input type="hidden" name="range" value={ p.TimeRange }/>
					if p.Filter != "" {
						<input type="hidden" name="group" value={ p.Filter }/>
					}
					<select name="ip" onchange="this.form.submit()" class="form-select-sm" aria-label="Client IP">
						<option value="">All IPs</option>
						for _, ip := range p.TopIPs {
							<option value={ ip } selected?={ ip == p.ClientIP }>{ ip }</option>
						}
					</select>
					<noscript><button type="submit" class="btn-secondary btn-sm">Apply</button></noscript>
				</form>
			}
		</div>
		if logs := p.logs(); len(logs) > 0 {
			<div class="panel">
				<div class="overflow-x-auto">
					<table class="w-full min-w-[800px]">
						<thead>
							<tr class="border-b border-line">
								<th class="th">Time</th>
								<th class="th">Method</th>
								<th class="th">Path</th>
								<th class="th">Status</th>
								<th class="th">Latency</th>
								<th class="th">Client</th>
								<th class="th">Group</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-line">
							for _, log := range logs {
								<tr>
									<td class="px-4 py-2.5 text-sm text-muted whitespace-nowrap">@RelTime(log.CreatedAt)</td>
									<td class="px-4 py-2.5 text-xs font-mono text-white">{ log.Method }</td>
									<td class="px-4 py-2.5 text-xs text-muted-light font-mono truncate max-w-[280px]" title={ log.Path }>{ log.Path }</td>
									<td class={ "px-4 py-2.5 text-sm font-mono tabular-nums", HttpStatusColor(log.StatusCode) }>{ fmt.Sprint(log.StatusCode) }</td>
									<td class="px-4 py-2.5 text-sm text-muted tabular-nums font-mono">{ FormatMs(log.LatencyMs) }</td>
									<td class="px-4 py-2.5 text-xs font-mono">
										<a href={ templ.SafeURL(p.href(p.TimeRange, p.Filter, log.ClientIP, 1)) } class="text-muted-light hover:text-white hover:underline">{ log.ClientIP }</a>
									</td>
									<td class="px-4 py-2.5 text-sm text-muted">{ routeGroupLabel(log.RouteGroup) }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
				if p.Result != nil && p.Result.TotalPages > 1 {
					@Pager(p.Result.Page, p.Result.TotalPages, fmt.Sprintf("Page %d of %d · %d entries", p.Result.Page, p.Result.TotalPages, p.Result.Total), p.href(p.TimeRange, p.Filter, p.ClientIP, p.Result.Page-1), p.href(p.TimeRange, p.Filter, p.ClientIP, p.Result.Page+1))
				}
			</div>
		} else {
			@EmptyState("No requests in this range.", "", "")
		}
	}
}

func routeGroupLabel(g string) string {
	if g == "api" {
		return "API"
	}
	return capitalize(g)
}

func capitalize(s string) string {
	if s == "" {
		return s
	}
	r, size := utf8.DecodeRuneInString(s)
	return string(unicode.ToUpper(r)) + s[size:]
}
