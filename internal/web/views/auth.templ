package views

type LoginParams struct {
	BasePath string
	Error    string
}

type TOTPParams struct {
	BasePath       string
	Error          string
	ChallengeToken string
}

// authHead is the <head> shared by the signed-out pages.
templ authHead(basePath, title string) {
	<meta charset="UTF-8"/>
	<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
	@themeScript()
	<title>{ title } · Asura</title>
	<link rel="icon" href={ basePath + "/static/favicon.ico" }/>
	<link rel="preload" href={ basePath + "/static/fonts/inter.woff2" } as="font" type="font/woff2" crossorigin/>
	<link rel="stylesheet" href={ Asset(basePath, "tailwind.css") }/>
}

// authShell centers a small form under the wordmark.
templ authShell(heading, subtitle, errMsg string) {
	<body class="bg-surface text-muted-light font-sans min-h-screen flex items-center justify-center px-4 antialiased">
		<main class="w-full max-w-sm">
			<div class="mb-8 text-center">
				<div class="text-3xl font-bold tracking-tight text-white">Asura</div>
			</div>
			<div class="card p-6">
				<h1 class="text-xl font-bold">{ heading }</h1>
				<p class="subtitle mt-1 mb-5">{ subtitle }</p>
				if errMsg != "" {
					<div role="alert" class="mb-4 px-3 py-2 border border-crit/40 rounded-control text-sm text-crit">{ errMsg }</div>
				}
				{ children... }
			</div>
		</main>
	</body>
}

templ LoginPage(p LoginParams) {
	<!DOCTYPE html>
	<html lang="en" data-theme="dark">
	<head>
		@authHead(p.BasePath, "Sign in")
	</head>
	@authShell("Sign in", "Use an API key from your Asura configuration.", p.Error) {
		<form method="POST" action={ templ.SafeURL(p.BasePath + "/login") } class="space-y-4">
			<div>
				<label class="form-label" for="api_key">API key</label>
				<input id="api_key" type="password" name="api_key" autocomplete="current-password" required autofocus class="form-input"/>
			</div>
			<button type="submit" class="btn-primary w-full h-9">Sign in</button>
		</form>
	}
	</html>
}

templ TOTPPage(p TOTPParams) {
	<!DOCTYPE html>
	<html lang="en" data-theme="dark">
	<head>
		@authHead(p.BasePath, "Two-factor authentication")
	</head>
	@authShell("Two-factor authentication", "Enter the 6-digit code from your authenticator app.", p.Error) {
		<form method="POST" action={ templ.SafeURL(p.BasePath + "/login/totp") } class="space-y-4">
			<input type="hidden" name="challenge" value={ p.ChallengeToken }/>
			<div>
				<label class="form-label" for="code">Code</label>
				<input id="code" type="text" name="code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" placeholder="000000" required autofocus class="form-input text-center font-mono tracking-[0.3em]"/>
			</div>
			<button type="submit" class="btn-primary w-full h-9">Verify</button>
		</form>
		<a href={ templ.SafeURL(p.BasePath + "/login") } class="block mt-4 text-center text-sm text-muted hover:text-white">Use a different key</a>
	}
	</html>
}
