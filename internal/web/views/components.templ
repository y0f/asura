package views

import (
	"fmt"

	"github.com/y0f/asura/internal/storage"
)

// PageHeaderParams describes the heading block at the top of every page.
type PageHeaderParams struct {
	Title     string
	Subtitle  string
	BackHref  string
	BackLabel string
}

// PageHeader renders the page's single <h1>, an optional back link above it and
// an optional subtitle below it. Children are the page actions, shown on the
// right of the title (or wrapped below it on narrow screens).
templ PageHeader(h PageHeaderParams) {
	<div class="mb-6">
		if h.BackHref != "" {
			<a href={ templ.SafeURL(h.BackHref) } class="inline-flex items-center gap-1 mb-2 text-sm text-muted hover:text-white">
				<svg aria-hidden="true" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg>
				{ h.BackLabel }
			</a>
		}
		<div class="flex flex-wrap items-center gap-x-4 gap-y-3">
			<h1 class="text-2xl sm:text-3xl font-bold text-white [overflow-wrap:anywhere] min-w-0">{ h.Title }</h1>
			<div class="flex flex-wrap items-center gap-2 grow">
				{ children... }
			</div>
		</div>
		if h.Subtitle != "" {
			<p class="subtitle mt-1.5">{ h.Subtitle }</p>
		}
	</div>
}

// StatCard is a single labelled metric. tone is a status tone ("ok", "warn",
// "crit") or "" for a neutral value.
templ StatCard(label, value, tone string) {
	<div class="card px-4 py-3 min-w-0">
		<div class="stat-label">{ label }</div>
		<div class={ "text-xl sm:text-2xl font-semibold tabular-nums truncate", toneText(tone) }>{ value }</div>
		{ children... }
	</div>
}

func toneText(tone string) string {
	switch tone {
	case "ok", "warn", "crit", "major", "info":
		return "text-" + tone
	case "muted":
		return "text-muted"
	default:
		return "text-white"
	}
}

// ConfirmModal is the single app-wide confirmation dialog, opened with
// $dispatch('confirm', {url, message}) (POSTs to url) or
// $dispatch('confirm', {message, onConfirm}) (runs a callback).
templ ConfirmModal() {
	<div
		x-data="{ open: false, url: '', message: '', callback: null, opener: null }"
		x-cloak
		@confirm.window="opener = document.activeElement; url = $event.detail.url || ''; message = $event.detail.message; callback = $event.detail.onConfirm || null; open = true; $nextTick(() => $refs.cancel && $refs.cancel.focus())"
		@keydown.escape.window="if (open) { open = false; opener && opener.focus() }"
	>
		<div x-show="open" class="fixed inset-0 z-50 flex items-center justify-center p-4">
			<div x-show="open" class="modal-backdrop fixed inset-0 bg-black/70" @click="open = false"></div>
			<div
				x-show="open"
				role="alertdialog"
				aria-modal="true"
				aria-labelledby="confirm-title"
				aria-describedby="confirm-msg"
				class="modal-panel relative z-10 w-full max-w-md border border-line-light rounded-card bg-surface-100 p-5"
			>
				<h2 id="confirm-title" class="text-lg font-semibold text-white mb-2">Are you sure?</h2>
				<p id="confirm-msg" class="text-sm text-muted-light mb-5" x-text="message"></p>
				<div class="flex items-center justify-end gap-2">
					<button x-ref="cancel" @click="open = false; opener && opener.focus()" type="button" class="btn-secondary">Cancel</button>
					<template x-if="url">
						<form method="POST" :action="url">
							<button type="submit" class="btn-danger">Continue</button>
						</form>
					</template>
					<template x-if="!url && callback">
						<button type="button" @click="callback(); open = false" class="btn-danger">Continue</button>
					</template>
				</div>
			</div>
		</div>
	</div>
}

// Toast is a status message pinned to the bottom-right corner. Errors stay
// until dismissed; success and warning messages dismiss themselves.
templ Toast(kind, msg string) {
	<div
		x-data={ "{show:true" + toastInit(kind) + "}" }
		x-show="show"
		if kind == "error" {
			role="alert"
		} else {
			role="status"
		}
		class="toast-in fixed bottom-4 right-4 z-[60] w-[calc(100%-2rem)] max-w-sm flex items-start gap-3 px-4 py-3 border border-line-light rounded-card bg-surface-100 text-sm text-white shadow-lg shadow-black/30"
	>
		<span class={ "dot mt-1.5", templ.KV("bg-ok", kind == "success"), templ.KV("bg-crit", kind == "error"), templ.KV("bg-warn", kind == "warning") }></span>
		<span class="flex-1 break-words">{ msg }</span>
		<button type="button" @click="show=false" aria-label="Dismiss" class="-mr-1 -mt-0.5 text-muted hover:text-white">
			@iconX()
		</button>
	</div>
}

func toastInit(kind string) string {
	switch kind {
	case "success":
		return ",init(){setTimeout(()=>this.show=false,5000)}"
	case "warning":
		return ",init(){setTimeout(()=>this.show=false,8000)}"
	default:
		return ""
	}
}

templ iconX() {
	<svg aria-hidden="true" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"></path></svg>
}

templ iconPlus() {
	<svg aria-hidden="true" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14m7-7H5"></path></svg>
}

templ iconEdit() {
	<svg aria-hidden="true" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"></path><path d="m15 5 4 4"></path></svg>
}

templ iconEye() {
	<svg aria-hidden="true" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
}

templ iconTrash() {
	<svg aria-hidden="true" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"></path><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path></svg>
}

// DeleteButton is the row-level delete action; it asks for confirmation first.
templ DeleteButton(action, message string) {
	<button
		type="button"
		data-url={ action }
		data-msg={ message }
		@click="$dispatch('confirm',{url:$el.dataset.url,message:$el.dataset.msg})"
		class="row-action hover:text-crit!"
		title="Delete"
		aria-label="Delete"
	>
		@iconTrash()
	</button>
}

// EmptyState is a focused, centered placeholder for empty lists: the message
// and an optional call-to-action link.
templ EmptyState(message, actionHref, actionLabel string) {
	<div class="card px-6 py-12 flex flex-col items-center text-center">
		<p class="text-sm text-muted-light">{ message }</p>
		if actionHref != "" {
			<a href={ templ.SafeURL(actionHref) } class="btn-secondary mt-4">{ actionLabel }</a>
		}
	</div>
}

// EmptyStateModal mirrors EmptyState, but its CTA runs an Alpine expression in
// the surrounding scope (e.g. "showForm = true") to open a create dialog.
templ EmptyStateModal(message, clickExpr, actionLabel string) {
	<div class="card px-6 py-12 flex flex-col items-center text-center">
		<p class="text-sm text-muted-light">{ message }</p>
		if actionLabel != "" {
			<button type="button" @click={ clickExpr } class="btn-secondary mt-4">{ actionLabel }</button>
		}
	</div>
}

// FormModal is the shared centered dialog for create/edit forms whose open state
// is owned by the surrounding page Alpine scope. show is the boolean expression to
// bind (e.g. "showForm"), maxWidth a max-w-* class, and titleExpr an Alpine
// expression for the heading. Backdrop click and Escape close it.
templ FormModal(show, maxWidth, titleExpr string) {
	<div
		x-show={ show }
		x-cloak
		@keydown.escape.window={ show + " = false" }
		@click.self={ show + " = false" }
		x-effect={ "if (" + show + ") $nextTick(() => { const f = $el.querySelector('input:not([type=hidden]),select,textarea'); f && f.focus() })" }
		class="modal-backdrop fixed inset-0 z-50 flex items-center justify-center bg-black/70 p-4"
	>
		<div
			x-show={ show }
			@click.stop
			role="dialog"
			aria-modal="true"
			aria-labelledby={ show + "-title" }
			class={ "modal-panel relative w-full max-h-[85vh] overflow-y-auto rounded-card border border-line-light bg-surface-100", maxWidth }
		>
			<div class="sticky top-0 z-10 flex items-center justify-between gap-3 border-b border-line bg-surface-100 px-5 py-3">
				<h2 id={ show + "-title" } class="text-lg font-semibold text-white" x-text={ titleExpr }></h2>
				<button type="button" @click={ show + " = false" } aria-label="Close" class="icon-btn -mr-2">
					@iconX()
				</button>
			</div>
			<div class="space-y-4 p-5">
				{ children... }
			</div>
		</div>
	</div>
}

// StatusPill renders a status as a coloured dot plus its label.
templ StatusPill(status string) {
	<span class={ "inline-flex items-center gap-1.5 text-sm font-medium whitespace-nowrap", StatusColor(status) }>
		<span class={ "dot", StatusDot(status) }></span>
		{ StatusLabel(status) }
	</span>
}

// SeverityPill renders an incident severity as a badge.
templ SeverityPill(severity string) {
	<span class={ "badge", SeverityBg(severity) }>{ capitalize(severity) }</span>
}

// ToolbarNewButton is the page-header "New X" primary action link.
templ ToolbarNewButton(href, label string) {
	<a href={ templ.SafeURL(href) } class="btn-primary">
		@iconPlus()
		{ label }
	</a>
}

// ToolbarNewButtonClick is ToolbarNewButton for create flows that open a dialog.
templ ToolbarNewButtonClick(clickExpr, label string) {
	<button type="button" @click={ clickExpr } class="btn-primary">
		@iconPlus()
		{ label }
	</button>
}

// SearchInput renders the standard search field with a leading magnifier icon.
templ SearchInput(name, value, placeholder string) {
	<div class="relative w-full sm:w-64">
		<svg aria-hidden="true" class="absolute left-2.5 top-1/2 -translate-y-1/2 w-4 h-4 text-muted pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
		<input type="search" name={ name } value={ value } placeholder={ placeholder } aria-label={ placeholder } class="form-input h-8 pl-8"/>
	</div>
}

// IncidentRow renders an active-incident summary row linking to the incident.
templ IncidentRow(basePath string, inc *storage.Incident) {
	<a href={ templ.SafeURL(fmt.Sprintf("%s/incidents/%d", basePath, inc.ID)) } class="block px-4 py-3 hover:bg-surface-200">
		<div class="flex items-center justify-between gap-3 mb-1">
			<span class="text-sm font-medium text-white truncate">{ inc.MonitorName }</span>
			@StatusPill(inc.Status)
		</div>
		<div class="text-xs text-muted truncate">{ inc.Cause }</div>
		<div class="text-xs text-muted mt-0.5">@RelTime(inc.StartedAt)</div>
	</a>
}

// MonitorRowActions renders the pause/resume + view + edit action cluster shared
// by the monitor list table and the group detail table. canWrite gates the
// mutating actions.
templ MonitorRowActions(basePath string, m *storage.Monitor, canWrite bool) {
	<div class="flex items-center justify-end gap-0.5">
		if canWrite {
			if m.Enabled {
				<form method="POST" action={ templ.SafeURL(fmt.Sprintf("%s/monitors/%d/pause", basePath, m.ID)) } class="contents">
					<button type="submit" class="row-action" title="Pause" aria-label={ "Pause " + m.Name }>
						<svg aria-hidden="true" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="6" y="4" width="4" height="16"></rect><rect x="14" y="4" width="4" height="16"></rect></svg>
					</button>
				</form>
			} else {
				<form method="POST" action={ templ.SafeURL(fmt.Sprintf("%s/monitors/%d/resume", basePath, m.ID)) } class="contents">
					<button type="submit" class="row-action" title="Resume" aria-label={ "Resume " + m.Name }>
						<svg aria-hidden="true" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
					</button>
				</form>
			}
			<a href={ templ.SafeURL(fmt.Sprintf("%s/monitors/%d/edit", basePath, m.ID)) } class="row-action" title="Edit" aria-label={ "Edit " + m.Name }>
				@iconEdit()
			</a>
		}
	</div>
}

// RelTime renders a relative time with the absolute UTC time available on hover
// and to assistive technology.
templ RelTime(t any) {
	if abs := absTime(t); abs != "" {
		<time datetime={ abs } title={ abs }>{ TimeAgo(t) }</time>
	} else {
		{ TimeAgo(t) }
	}
}

// Pager renders the "Page x / y" footer with previous/next links.
templ Pager(page, totalPages int, summary, prevHref, nextHref string) {
	<div class="px-4 py-2.5 border-t border-line flex items-center justify-between gap-3">
		<span class="text-xs text-muted tabular-nums">{ summary }</span>
		<div class="flex gap-1">
			if page > 1 {
				@PrevPageBtn(prevHref)
			}
			if page < totalPages {
				@NextPageBtn(nextHref)
			}
		</div>
	</div>
}

// MonitorListListener generalizes the dashboard SSE bridge for the monitor list
// and detail pages: it forwards relevant server-sent events into an htmx
// sse:refresh trigger on the given target element id.
templ MonitorListListener(basePath, targetID string) {
	<div class="hidden" data-sse-url={ basePath + "/events" } data-sse-target={ targetID }></div>
	<script src={ basePath + "/static/sse-refresh.js" } defer></script>
}

// Settings field helpers shared by the per-type monitor settings blocks.

// SettingText renders a labelled single-line text-ish input (text, url, etc.).
templ SettingText(label, name, value, placeholder, inputType string) {
	<div>
		<label class="form-label" for={ name }>{ label }</label>
		<input id={ name } type={ inputType } name={ name } value={ value } placeholder={ placeholder } class="form-input"/>
	</div>
}

// SettingPassword renders a labelled secret input. The stored value is never
// written into the page: when one exists the field is empty and says so, and
// submitting it blank keeps the stored value.
templ SettingPassword(label, name, stored, placeholder string) {
	<div>
		<label class="form-label" for={ name }>{ label }</label>
		<input id={ name } type="password" name={ name } autocomplete="new-password"
			if stored != "" {
				placeholder="Saved. Leave blank to keep it."
			} else {
				placeholder={ placeholder }
			}
			class="form-input"/>
	</div>
}

// SettingNumber renders a labelled number input. value/min/max/extraClass are
// passed verbatim; extraClass defaults handled by caller.
templ SettingNumber(label, name, value, placeholder, min, max, extraClass string) {
	<div>
		<label class="form-label" for={ name }>{ label }</label>
		<input id={ name } type="number" name={ name } value={ value } placeholder={ placeholder } min={ min } max={ max } class={ "form-input tabular-nums", extraClass }/>
	</div>
}

// SettingCheckbox renders a labelled checkbox. checked controls the initial
// state of the box.
templ SettingCheckbox(label, name string, checked bool) {
	<label class="flex items-center gap-2 cursor-pointer">
		<input type="checkbox" name={ name }
			if checked {
				checked
			}
			class="form-checkbox"/>
		<span class="text-sm text-muted-light">{ label }</span>
	</label>
}

// HeaderListEditor renders the dynamic Alpine "+ Add Header" key/value editor.
// modelName is the Alpine collection (e.g. "httpHeaders"), keyName/valName the
// posted field names.
templ HeaderListEditor(modelName, keyName, valName string) {
	<div>
		<div class="form-label">Headers</div>
		<div class="space-y-2">
			<template x-for={ "(h, i) in " + modelName } :key="i">
				<div class="flex gap-2">
					<input type="text" :name={ "'" + keyName + "'" } x-model="h.key" placeholder="Header name" aria-label="Header name" class="form-input flex-1"/>
					<input type="text" :name={ "'" + valName + "'" } x-model="h.value" placeholder="Value" aria-label="Header value" class="form-input flex-1"/>
					<button type="button" @click={ modelName + ".splice(i, 1)" } aria-label="Remove header" title="Remove" class="row-action hover:text-crit">
						@iconX()
					</button>
				</div>
			</template>
		</div>
		<button type="button" @click={ modelName + ".push({key:'', value:''})" } class="btn-secondary btn-sm mt-2">Add header</button>
	</div>
}
