package views

import (
	"fmt"

	"github.com/y0f/asura/internal/storage"
)

type OnCallListParams struct {
	LayoutParams
	Rotations []*storage.OnCallRotation
	Channels  []*storage.NotificationChannel
}

func channelName(channels []*storage.NotificationChannel, id int64) string {
	for _, ch := range channels {
		if ch.ID == id {
			return ch.Name
		}
	}
	return fmt.Sprintf("#%d", id)
}

templ OnCallListPage(p OnCallListParams) {
	@Layout(p.LayoutParams) {
		<div x-data="{showForm: false, showOverride: false, overrideId: 0}">
			@PageHeader(PageHeaderParams{Title: "On-Call", Subtitle: "Rotate which notification channel is paged, daily or weekly."}) {
				if p.Can("notifications.write") {
					@ToolbarNewButtonClick("showForm = true", "New rotation")
				}
			}
			if len(p.Rotations) > 0 {
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
					for _, rot := range p.Rotations {
						<div class="card card-pad">
							<div class="flex items-center justify-between gap-3 mb-3">
								<div class="flex items-center gap-2 min-w-0">
									<h2 class="text-md font-semibold truncate">{ rot.Name }</h2>
									<span class="badge">{ capitalize(rot.Period) }</span>
								</div>
								if p.Can("notifications.write") {
									<div class="flex items-center gap-1 shrink-0">
										<button type="button" @click={ fmt.Sprintf("overrideId = %d; showOverride = true", rot.ID) } class="btn-secondary btn-sm">Override</button>
										@DeleteButton(fmt.Sprintf("%s/on-call/%d/delete", p.BasePath, rot.ID), "Delete this rotation?")
									</div>
								}
							</div>
							<ol class="space-y-1">
								for i, chID := range rot.ChannelIDs {
									<li class="flex items-center gap-2 text-sm">
										<span class="w-5 text-right text-muted tabular-nums">{ fmt.Sprint(i + 1) }.</span>
										if i == rot.CurrentIndex%len(rot.ChannelIDs) {
											<span class="text-white font-medium">{ channelName(p.Channels, chID) }</span>
											<span class="badge badge-emerald">On call now</span>
										} else {
											<span class="text-muted-light">{ channelName(p.Channels, chID) }</span>
										}
									</li>
								}
							</ol>
							if rot.OverrideChannelID != nil && rot.OverrideUntil != nil {
								<p class="mt-3 text-sm text-warn">
									Override: { channelName(p.Channels, *rot.OverrideChannelID) } until { rot.OverrideUntil.UTC().Format("Jan 2, 15:04") } UTC
								</p>
							}
						</div>
					}
				</div>
			} else if p.Can("notifications.write") {
				@EmptyStateModal("No on-call rotations yet.", "showForm = true", "Create a rotation")
			} else {
				@EmptyState("No on-call rotations yet.", "", "")
			}
			@FormModal("showForm", "max-w-md", "'New rotation'") {
				<form method="POST" action={ templ.SafeURL(p.BasePath + "/on-call") } class="space-y-4">
					<div>
						<label class="form-label" for="rot-name">Name</label>
						<input id="rot-name" type="text" name="name" required placeholder="Primary on-call" class="form-input"/>
					</div>
					<div>
						<label class="form-label" for="period">Rotates</label>
						<select id="period" name="period" class="form-select">
							<option value="daily">Daily</option>
							<option value="weekly">Weekly</option>
						</select>
					</div>
					<fieldset>
						<legend class="form-label">Channels in the rotation</legend>
						<div class="space-y-2 max-h-48 overflow-y-auto">
							for _, ch := range p.Channels {
								<label class="flex items-center gap-2 cursor-pointer">
									<input type="checkbox" name="channel_ids[]" value={ fmt.Sprint(ch.ID) } class="form-checkbox"/>
									<span class="text-sm text-white">{ ch.Name }</span>
									<span class="text-sm text-muted">{ ch.Type }</span>
								</label>
							}
						</div>
						<p class="form-hint">Channels take turns in the order they are listed.</p>
					</fieldset>
					<div class="flex items-center gap-2 pt-1">
						<button type="submit" class="btn-primary">Create rotation</button>
						<button type="button" @click="showForm = false" class="btn-secondary">Cancel</button>
					</div>
				</form>
			}
			@FormModal("showOverride", "max-w-md", "'Override on-call'") {
				<form method="POST" :action={ fmt.Sprintf("'%s/on-call/' + overrideId + '/override'", JSEscapeString(p.BasePath)) } class="space-y-4">
					<div>
						<label class="form-label" for="override_channel_id">Channel</label>
						<select id="override_channel_id" name="override_channel_id" class="form-select">
							<option value="">Clear override</option>
							for _, ch := range p.Channels {
								<option value={ fmt.Sprint(ch.ID) }>{ ch.Name }</option>
							}
						</select>
					</div>
					<div>
						<label class="form-label" for="override_until">Until</label>
						<input id="override_until" type="datetime-local" name="override_until" class="form-input"/>
						<p class="form-hint">UTC.</p>
					</div>
					<div class="flex items-center gap-2 pt-1">
						<button type="submit" class="btn-primary">Save override</button>
						<button type="button" @click="showOverride = false" class="btn-secondary">Cancel</button>
					</div>
				</form>
			}
		</div>
	}
}
