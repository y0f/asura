package views

import (
	"fmt"
	"time"

	"github.com/y0f/asura/internal/sla"
)

type SLAReportParams struct {
	LayoutParams
	Entries []*sla.ReportEntry
	Period  time.Time
}

func (p SLAReportParams) prevPeriod() string {
	return p.Period.AddDate(0, -1, 0).Format("2006-01")
}

func (p SLAReportParams) nextPeriod() string {
	return p.Period.AddDate(0, 1, 0).Format("2006-01")
}

func (p SLAReportParams) isCurrentMonth() bool {
	now := time.Now().UTC()
	return p.Period.Year() == now.Year() && p.Period.Month() == now.Month()
}

func (p SLAReportParams) isFutureMonth() bool {
	now := time.Now().UTC()
	nextMonth := time.Date(now.Year(), now.Month()+1, 1, 0, 0, 0, 0, time.UTC)
	return !p.Period.Before(nextMonth)
}

// slaState is the one place that decides whether an SLA entry is healthy, at
// risk (under 10% of the error budget left) or breached.
func slaState(entry *sla.ReportEntry) (label, tone string) {
	switch {
	case entry.Breached:
		return "Breached", "crit"
	case entry.RemainSecs <= entry.BudgetSecs/10:
		return "At risk", "warn"
	default:
		return "Healthy", "ok"
	}
}

templ SLAReportPage(p SLAReportParams) {
	@Layout(p.LayoutParams) {
		@PageHeader(PageHeaderParams{Title: "SLA Report", Subtitle: "Monthly uptime against each monitor's SLA target."}) {
			<div class="flex items-center gap-1 sm:ml-auto">
				if !p.isFutureMonth() {
					<a href={ templ.SafeURL(fmt.Sprintf("%s/sla?period=%s", p.BasePath, p.prevPeriod())) } class="icon-btn border border-line-light" aria-label="Previous month" title="Previous month">
						<svg aria-hidden="true" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg>
					</a>
				}
				<span class="px-2 text-sm text-white font-medium tabular-nums min-w-[8.5rem] text-center">{ p.Period.Format("January 2006") }</span>
				if !p.isCurrentMonth() && !p.isFutureMonth() {
					<a href={ templ.SafeURL(fmt.Sprintf("%s/sla?period=%s", p.BasePath, p.nextPeriod())) } class="icon-btn border border-line-light" aria-label="Next month" title="Next month">
						<svg aria-hidden="true" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg>
					</a>
				} else {
					<span class="icon-btn border border-line opacity-40" aria-hidden="true">
						<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg>
					</span>
				}
				<a href={ templ.SafeURL(fmt.Sprintf("%s/sla/export?period=%s", p.BasePath, p.Period.Format("2006-01"))) } class="btn-secondary ml-2">Export JSON</a>
			</div>
		}
		if len(p.Entries) == 0 {
			<div class="card px-6 py-12 text-center">
				<p class="text-sm text-muted-light">No monitors have an SLA target.</p>
				<p class="text-sm text-muted mt-1">Set one under "Routing &amp; behaviour" when editing a monitor.</p>
			</div>
		} else {
			<div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-6">
				@StatCard("Monitors tracked", fmt.Sprint(len(p.Entries)), "")
				@StatCard("Meeting target", fmt.Sprint(p.meetingSLA()), toneIf(p.meetingSLA() > 0, "ok"))
				@StatCard("Breached", fmt.Sprint(p.breachedCount()), toneIf(p.breachedCount() > 0, "crit"))
			</div>
			<div class="panel overflow-x-auto">
				<table class="w-full min-w-[760px]">
					<thead>
						<tr class="border-b border-line">
							<th class="th">Monitor</th>
							<th class="th">Target</th>
							<th class="th">Actual</th>
							<th class="th">Status</th>
							<th class="th">Error budget left</th>
							<th class="th">Checks</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-line">
						for _, entry := range p.Entries {
							<tr>
								<td class="px-4 py-3">
									<a href={ templ.SafeURL(fmt.Sprintf("%s/monitors/%d", p.BasePath, entry.MonitorID)) } class="text-sm text-white font-medium hover:underline">{ entry.MonitorName }</a>
								</td>
								<td class="px-4 py-3 text-sm text-muted-light tabular-nums">{ fmt.Sprintf("%.2f%%", entry.Target) }</td>
								<td class={ "px-4 py-3 text-sm font-medium tabular-nums", UptimeColor(entry.UptimePct) }>{ UptimeFmt(entry.UptimePct) }</td>
								<td class="px-4 py-3">
									{{ label, tone := slaState(entry) }}
									<span class={ "inline-flex items-center gap-1.5 text-sm whitespace-nowrap", "text-" + tone }><span class={ "dot", "bg-" + tone }></span>{ label }</span>
								</td>
								<td class="px-4 py-3">
									<div class="text-sm text-white tabular-nums">{ sla.FormatDuration(entry.RemainSecs) }</div>
									<div class="text-xs text-muted">of { sla.FormatDuration(entry.BudgetSecs) }</div>
								</td>
								<td class="px-4 py-3 text-sm text-muted-light tabular-nums">
									{ fmt.Sprint(entry.TotalChecks) }
									if entry.DownChecks > 0 {
										<span class="text-crit ml-1">({ fmt.Sprint(entry.DownChecks) } failed)</span>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
}

func (p SLAReportParams) breachedCount() int {
	n := 0
	for _, e := range p.Entries {
		if e.Breached {
			n++
		}
	}
	return n
}

func (p SLAReportParams) meetingSLA() int {
	return len(p.Entries) - p.breachedCount()
}
