package views

import "encoding/json"

// CommandPalette is the app-wide "go to page" dialog. Opened with Ctrl+K / ⌘K
// or "/", it filters the navigation destinations as you type and jumps to the
// highlighted page on Enter. Rendered once per page in the
// app shell. The index is purely client-side - no backend round-trip.
templ CommandPalette(p LayoutParams) {
	<div
		x-data="cmdPalette()"
		data-nav={ navIndexJSON(p) }
		@keydown.window="hotkey($event)"
		@cmdk-open.window="openPalette()"
	>
		<dialog x-cloak class="modal-dialog w-[calc(100%-2rem)] max-w-xl" aria-label="Go to page"
			x-effect={ dialogEffect("open") } @cancel.prevent="close()" @close="if (!$el.open) open = false" @click={ dialogBackdropClose("open") } @keydown.tab={ dialogTabCycle() }>
			<div class="w-full">
				<div
					class="modal-panel overflow-hidden rounded-card border border-line-light bg-surface-100 shadow-lg shadow-black/40"
				>
					<div class="flex items-center gap-3 px-4 border-b border-line">
						<svg class="w-4 h-4 text-muted shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.35-4.35"></path></svg>
						<input
							x-ref="input"
							autofocus
							type="search"
							autocomplete="off"
							role="combobox"
							aria-controls="cmd-list"
							aria-label="Go to page"
							:aria-expanded="results.length > 0"
							:aria-activedescendant="results.length ? 'cmd-opt-' + active : null"
							placeholder="Go to page…"
							class="cmdk-input flex-1 appearance-none border-0 bg-transparent py-3 text-sm text-white placeholder-muted outline-none focus:ring-0 [&::-webkit-search-cancel-button]:appearance-none"
							x-model="q"
							@input="filter()"
							@keydown.down.prevent="move(1)"
							@keydown.up.prevent="move(-1)"
							@keydown.enter.prevent="go()"
						/>
					</div>
					<div id="cmd-list" role="listbox" aria-label="Search results" x-ref="list" class="max-h-[22rem] overflow-y-auto p-1.5">
						<template x-for="(h, i) in results" :key="h.href">
							<a
								:href="h.href"
								:id="'cmd-opt-' + i"
								role="option"
								:aria-selected="i === active"
								:data-active="i === active"
								@mouseenter="active = i"
								class="cmdk-hit group flex items-center gap-3 rounded-control px-3 py-2 cursor-pointer text-muted-light"
								:class="i === active && 'is-active'"
							>
								<span class="min-w-0 flex-1">
									<span class="block truncate text-sm text-white" x-text="h.label"></span>
									<span class="block truncate text-xs text-muted" x-text="h.group + ' · ' + h.desc"></span>
								</span>
							</a>
						</template>
						<div x-show="results.length === 0" class="px-4 py-10 text-center text-sm text-muted">No results for "<span class="text-muted-light" x-text="q"></span>".</div>
					</div>
					<div class="flex items-center gap-4 border-t border-line px-4 py-2 text-xs text-muted">
						<span class="flex items-center gap-1.5">
							@kbdIcon("M12 19V5M5 12l7-7 7 7")
							@kbdIcon("M12 5v14M19 12l-7 7-7-7")
							<span class="ml-px">to navigate</span>
						</span>
						<span class="flex items-center gap-1.5">
							@kbdIcon("M9 10l-5 5 5 5M4 15h11a4 4 0 0 0 4-4V4")
							<span class="ml-px">to select</span>
						</span>
						<span class="hidden sm:flex items-center gap-1.5">
							<kbd class="inline-flex h-5 items-center justify-center rounded-[3px] border border-line-light px-1.5 text-2xs font-mono text-muted">esc</kbd>
							<span class="ml-px">to close</span>
						</span>
					</div>
				</div>
			</div>
		</dialog>
	</div>
	@cmdPaletteScript()
}

templ kbdIcon(d string) {
	<kbd class="inline-flex h-5 w-5 items-center justify-center rounded-[3px] border border-line-light text-muted">
		<svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d={ d }></path></svg>
	</kbd>
}

templ cmdPaletteScript() {
	<script>
		function cmdPalette() {
			return {
				open: false, q: "", active: 0, all: [], results: [],
				init() {
					try { this.all = JSON.parse(this.$el.dataset.nav || "[]"); }
					catch (e) { this.all = []; }
					this.results = this.all;
				},
				hotkey(e) {
					if (!this.open && document.querySelector('dialog[open]')) return;
					const cmdK = (e.key === "k" || e.key === "K") && (e.metaKey || e.ctrlKey);
					const slash = e.key === "/" && !this.typing(e.target);
					if (cmdK || slash) { e.preventDefault(); this.toggle(); }
				},
				typing(t) { return t && (t.tagName === "INPUT" || t.tagName === "TEXTAREA" || t.tagName === "SELECT" || t.isContentEditable); },
				toggle() { this.open ? this.close() : this.openPalette(); },
				openPalette() {
					this.open = true; this.q = ""; this.filter();
					this.$nextTick(() => { if (this.$refs.input) this.$refs.input.focus(); });
				},
				close() { this.open = false; this.q = ""; },
				filter() {
					const q = this.q.trim().toLowerCase();
					this.results = q
						? this.all.filter(h => (h.label + " " + h.desc + " " + h.group).toLowerCase().includes(q))
						: this.all;
					this.active = 0;
				},
				move(d) {
					if (!this.results.length) return;
					this.active = (this.active + d + this.results.length) % this.results.length;
					this.$nextTick(() => {
						const el = this.$refs.list && this.$refs.list.querySelector('[data-active="true"]');
						if (el) el.scrollIntoView({ block: "nearest" });
					});
				},
				go() { const h = this.results[this.active]; if (h) window.location.href = h.href; },
			};
		}
	</script>
}

type navSearchItem struct {
	Label string `json:"label"`
	Desc  string `json:"desc"`
	Href  string `json:"href"`
	Group string `json:"group"`
}

func navIndexJSON(p LayoutParams) string {
	items := []navSearchItem{
		{"Dashboard", "Overview of monitors and incidents", "/", "Home"},
		{"Monitors", "All monitors and their status", "/monitors", "Monitoring"},
		{"New Monitor", "Create a new monitor", "/monitors/new", "Monitoring"},
		{"Groups", "Monitor groups", "/groups", "Monitoring"},
		{"Tags", "Monitor tags", "/tags", "Monitoring"},
		{"Incidents", "Incident history and active incidents", "/incidents", "Alerting"},
		{"Notifications", "Notification channels", "/notifications", "Alerting"},
		{"Notification History", "Sent notification log", "/notifications/history", "Alerting"},
		{"Escalation Policies", "On-call escalation rules", "/escalation-policies", "Alerting"},
		{"On-Call", "On-call rotations", "/on-call", "Alerting"},
		{"SLA Report", "Uptime and SLA reporting", "/sla", "Operations"},
		{"Maintenance", "Scheduled maintenance windows", "/maintenance", "Operations"},
		{"Status Pages", "Public status pages", "/status-pages", "Operations"},
		{"Request Logs", "HTTP requests served by Asura", "/logs", "System"},
		{"Audit Log", "Who changed what", "/audit", "System"},
		{"Agents", "Remote monitoring agents", "/agents", "System"},
		{"Proxies", "Outbound proxies", "/proxies", "System"},
		{"Settings", "Application settings", "/settings", "System"},
	}
	allowed := make([]navSearchItem, 0, len(items))
	for _, item := range items {
		if p.CanVisit(item.Href) {
			item.Href = p.BasePath + item.Href
			allowed = append(allowed, item)
		}
	}
	b, err := json.Marshal(allowed)
	if err != nil {
		return "[]"
	}
	return string(b)
}
