package views

import (
	"fmt"
	"strconv"

	"github.com/y0f/asura/internal/storage"
)

type StatusPageListParams struct {
	LayoutParams
	Pages []*storage.StatusPage
}

type StatusPageFormParams struct {
	LayoutParams
	StatusPage   *storage.StatusPage
	Monitors     []*storage.Monitor
	Assigned     map[int64]bool
	AssignedData map[int64]storage.StatusPageMonitor
}

templ StatusPageListPage(p StatusPageListParams) {
	@Layout(p.LayoutParams) {
		@PageHeader(PageHeaderParams{Title: "Status Pages", Subtitle: "Public pages that show your customers what is up."}) {
			if p.Can("monitors.write") {
				@ToolbarNewButton(p.BasePath+"/status-pages/new", "New status page")
			}
		}
		if len(p.Pages) > 0 {
			<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
				for _, sp := range p.Pages {
					<div class="card card-pad flex flex-col">
						<div class="flex items-start justify-between gap-3">
							<div class="min-w-0">
								<h2 class="text-md font-semibold truncate">{ sp.Title }</h2>
								<div class="text-sm text-muted font-mono truncate">{ p.BasePath }/{ sp.Slug }</div>
							</div>
							if sp.Enabled {
								<span class="inline-flex items-center gap-1.5 text-sm text-ok shrink-0"><span class="dot bg-ok"></span>Public</span>
							} else {
								<span class="inline-flex items-center gap-1.5 text-sm text-muted shrink-0"><span class="dot bg-muted"></span>Disabled</span>
							}
						</div>
						<p class="text-sm text-muted-light mt-3 mb-4">{ fmt.Sprintf("%d monitor%s", sp.MonitorCount, plural(int64(sp.MonitorCount))) }</p>
						<div class="mt-auto flex items-center gap-2 pt-3 border-t border-line">
							if sp.Enabled {
								<a href={ templ.SafeURL(fmt.Sprintf("%s/%s", p.BasePath, sp.Slug)) } target="_blank" rel="noopener" class="btn-secondary btn-sm">Open<span class="sr-only"> (opens in a new tab)</span></a>
							}
							if p.Can("monitors.write") {
								<a href={ templ.SafeURL(fmt.Sprintf("%s/status-pages/%d/edit", p.BasePath, sp.ID)) } class="btn-secondary btn-sm">Edit</a>
								<div class="ml-auto">
									@DeleteButton(fmt.Sprintf("%s/status-pages/%d/delete", p.BasePath, sp.ID), "Delete this status page? Its public URL stops working.")
								</div>
							}
						</div>
					</div>
				}
			</div>
		} else if p.Can("monitors.write") {
			@EmptyState("No status pages yet.", p.BasePath+"/status-pages/new", "Create a status page")
		} else {
			@EmptyState("No status pages yet.", "", "")
		}
	}
}

func (p StatusPageFormParams) header() PageHeaderParams {
	if p.StatusPage != nil {
		return PageHeaderParams{Title: "Edit status page", Subtitle: p.StatusPage.Title, BackHref: p.BasePath + "/status-pages", BackLabel: "Status Pages"}
	}
	return PageHeaderParams{Title: "New status page", BackHref: p.BasePath + "/status-pages", BackLabel: "Status Pages"}
}

templ StatusPageFormPage(p StatusPageFormParams) {
	@Layout(p.LayoutParams) {
		@PageHeader(p.header())
		<div>
			<form method="POST"
				if p.StatusPage != nil {
					action={ templ.SafeURL(fmt.Sprintf("%s/status-pages/%d", p.BasePath, p.StatusPage.ID)) }
				} else {
					action={ templ.SafeURL(p.BasePath + "/status-pages") }
				}
				class="max-w-3xl space-y-6">
				<div class="card card-pad space-y-4">
				<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
					<div>
						<label class="form-label" for="title">Title</label>
						<input id="title" type="text" name="title"
							if p.StatusPage != nil {
								value={ p.StatusPage.Title }
							}
							required class="form-input" placeholder="Service Status"/>
					</div>
					<div>
						<label class="form-label" for="slug">URL Slug</label>
						<div class="flex items-center gap-0">
							<span class="h-9 inline-flex items-center px-2.5 bg-surface-200 border border-r-0 border-line-light rounded-l-control text-muted text-sm">{ p.BasePath }/</span>
							<input id="slug" type="text" name="slug"
								if p.StatusPage != nil {
									value={ p.StatusPage.Slug }
								} else {
									value="status"
								}
								required class="form-input flex-1 rounded-l-none" placeholder="status" pattern="[a-z0-9][a-z0-9-]*[a-z0-9]|[a-z0-9]"/>
						</div>
						<p class="form-hint">Lowercase letters, numbers and hyphens.</p>
					</div>
				</div>
				<div>
					<label class="form-label" for="description">Description</label>
					<textarea id="description" name="description" rows="2" class="form-input resize-y" placeholder="Current status of our services">
						if p.StatusPage != nil {
							{ p.StatusPage.Description }
						}
					</textarea>
				</div>
				<div class="flex flex-wrap gap-x-6 gap-y-3">
					@statusToggle("enabled", "Public", p.StatusPage != nil && p.StatusPage.Enabled)
					@statusToggle("api_enabled", "Public JSON API", p.StatusPage != nil && p.StatusPage.APIEnabled)
					@statusToggle("show_incidents", "Show incidents", p.StatusPage == nil || p.StatusPage.ShowIncidents)
				</div>
				<div>
					<label class="form-label" for="sort_order">Sort Order</label>
					<input id="sort_order" type="number" name="sort_order"
						if p.StatusPage != nil {
							value={ strconv.Itoa(p.StatusPage.SortOrder) }
						} else {
							value="0"
						}
						class="form-input w-28"/>
				</div>
				</div>
				<div x-data="{search: ''}" class="panel">
					<div class="px-4 py-2.5 border-b border-line flex items-center justify-between gap-3">
						<h2 class="text-md font-semibold">Monitors</h2>
						<input type="search" x-model="search" placeholder="Filter" aria-label="Filter monitors" class="form-input h-8 w-44"/>
					</div>
					<div class="divide-y divide-line max-h-64 overflow-y-auto">
						for _, m := range p.Monitors {
							<div x-data={ fmt.Sprintf("{checked:%v}", p.Assigned[m.ID]) }
								data-name={ m.Name }
								x-show="!search || $el.dataset.name.toLowerCase().includes(search.toLowerCase())"
								:class="checked && 'bg-surface-200'"
								class="px-4 py-2.5">
								<div class="flex items-center gap-3">
									<input type="checkbox" name={ fmt.Sprintf("monitor_%d_enabled", m.ID) } class="form-checkbox shrink-0" x-model="checked" aria-label={ "Show " + m.Name }/>
									<div class="flex-1 min-w-0">
										<span class="text-sm text-white">{ m.Name }</span>
										<span class="ml-1.5 text-sm text-muted">{ TypeLabel(m.Type) }</span>
									</div>
									<div x-show="checked" x-cloak class="flex items-center gap-2 shrink-0">
										<input type="number" name={ fmt.Sprintf("monitor_%d_sort", m.ID) } placeholder="0" value={ statusPageMonitorSort(p.AssignedData, m.ID) } class="form-input h-8 w-16 text-center" aria-label={ "Sort order for " + m.Name } title="Sort order"/>
										<input type="text" name={ fmt.Sprintf("monitor_%d_group", m.ID) } placeholder="Group" value={ statusPageMonitorGroup(p.AssignedData, m.ID) } class="form-input h-8 w-32" aria-label={ "Section for " + m.Name } title="Section heading on the public page"/>
									</div>
								</div>
							</div>
						}
					</div>
					if len(p.Monitors) == 0 {
						<div class="px-4 py-10 text-center text-sm text-muted">No monitors yet.</div>
					}
				</div>
				<div x-data="{showAdvanced: false}">
					<button type="button" @click="showAdvanced = !showAdvanced" :aria-expanded="showAdvanced" class="flex items-center gap-2 text-lg font-semibold text-white">
						<svg aria-hidden="true" class="w-4 h-4 text-muted transition-transform" :class="showAdvanced && 'rotate-90'" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
						Branding and access
					</button>
					<div x-show="showAdvanced" x-cloak class="mt-4 card card-pad space-y-4">
						<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
							<div>
								<label class="form-label" for="logo_url">Logo URL</label>
								<input id="logo_url" type="url" name="logo_url"
									if p.StatusPage != nil {
										value={ p.StatusPage.LogoURL }
									}
									class="form-input" placeholder="https://example.com/logo.png"/>
								<p class="form-hint">Displayed above the status banner.</p>
							</div>
							<div>
								<label class="form-label" for="favicon_url">Favicon URL</label>
								<input id="favicon_url" type="url" name="favicon_url"
									if p.StatusPage != nil {
										value={ p.StatusPage.FaviconURL }
									}
									class="form-input" placeholder="https://example.com/favicon.ico"/>
							</div>
						</div>
						<div>
							<label class="form-label" for="custom_header_html">Custom Header HTML</label>
							<textarea id="custom_header_html" name="custom_header_html" rows="3" class="form-input text-xs font-mono resize-y" placeholder="<!-- HTML injected before the status banner -->">
								if p.StatusPage != nil {
									{ p.StatusPage.CustomHeaderHTML }
								}
							</textarea>
						</div>
						<div>
							<label class="form-label" for="password">Password Protection</label>
							<input id="password" type="password" name="password" autocomplete="new-password" class="form-input" placeholder="Leave blank to keep unchanged"/>
							<p class="form-hint">Visitors must enter this password to view the page.</p>
							if p.StatusPage != nil && p.StatusPage.PasswordEnabled {
								<div class="mt-2 flex items-center gap-2">
									<input type="checkbox" name="clear_password" id="clear_password" class="form-checkbox"/>
									<label for="clear_password" class="text-sm text-muted-light cursor-pointer">Remove password protection</label>
								</div>
							}
						</div>
						<div>
							<label class="form-label" for="custom_css">Custom CSS</label>
							<textarea id="custom_css" name="custom_css" rows="4" class="form-input text-xs font-mono resize-y" placeholder="/* Custom styles for this status page */">
								if p.StatusPage != nil {
									{ p.StatusPage.CustomCSS }
								}
							</textarea>
						</div>
						<div>
							<label class="form-label" for="analytics_script">Analytics Script</label>
							<textarea id="analytics_script" name="analytics_script" rows="3" class="form-input text-xs font-mono resize-y" placeholder="<!-- e.g. Plausible, Fathom, or Google Analytics snippet -->">
								if p.StatusPage != nil {
									{ p.StatusPage.AnalyticsScript }
								}
							</textarea>
							<p class="form-hint">Injected before &lt;/body&gt; on the public status page.</p>
						</div>
					</div>
				</div>
				<div class="flex items-center gap-2">
					<button type="submit" class="btn-primary">
						if p.StatusPage != nil {
							Save changes
						} else {
							Create status page
						}
					</button>
					<a href={ templ.SafeURL(p.BasePath + "/status-pages") } class="btn-secondary">Cancel</a>
				</div>
			</form>
		</div>
	}
}

templ statusToggle(name, label string, checked bool) {
	<label class="switch">
		<input type="checkbox" name={ name }
			if checked {
				checked
			}/>
		<span class="switch-track"><span class="switch-dot"></span></span>
		<span class="text-sm text-white">{ label }</span>
	</label>
}
