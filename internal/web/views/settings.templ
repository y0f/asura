package views

import (
	"fmt"
	"runtime"
)

type SettingsParams struct {
	LayoutParams
	DBSizeBytes    int64
	AppVersion     string
	Uptime         string
	MonitorCount   int64
	WorkerCount    int
	RetentionDays  int
	EncryptionOn   bool
}

func formatBytes(b int64) string {
	const unit = 1024
	if b < unit {
		return fmt.Sprintf("%d B", b)
	}
	div, exp := int64(unit), 0
	for n := b / unit; n >= unit; n /= unit {
		div *= unit
		exp++
	}
	return fmt.Sprintf("%.1f %cB", float64(b)/float64(div), "KMGTPE"[exp])
}

templ settingsFact(label string) {
	<div class="py-2">
		<dt class="text-xs text-muted">{ label }</dt>
		<dd class="text-sm text-white font-medium mt-0.5">{ children... }</dd>
	</div>
}

templ SettingsPage(p SettingsParams) {
	@Layout(p.LayoutParams) {
		@PageHeader(PageHeaderParams{Title: "Settings", Subtitle: "Instance information, configuration backup and database maintenance."})
		<div class="space-y-6 max-w-5xl">
			<section class="card card-pad" aria-labelledby="sys-title">
				<h2 id="sys-title" class="text-lg font-semibold mb-2">System</h2>
				<dl class="grid grid-cols-2 md:grid-cols-4 gap-x-6">
					@settingsFact("Version") {
						{ p.AppVersion }
					}
					@settingsFact("Go") {
						{ runtime.Version() }
					}
					@settingsFact("Uptime") {
						{ p.Uptime }
					}
					@settingsFact("Database size") {
						{ formatBytes(p.DBSizeBytes) }
					}
					@settingsFact("Monitors") {
						{ fmt.Sprint(p.MonitorCount) }
					}
					@settingsFact("Check workers") {
						{ fmt.Sprint(p.WorkerCount) }
					}
					@settingsFact("History retention") {
						{ fmt.Sprintf("%d days", p.RetentionDays) }
					}
					@settingsFact("Secrets at rest") {
						if p.EncryptionOn {
							<span class="text-ok">Encrypted</span>
						} else {
							<span class="text-muted-light">Not encrypted</span>
						}
					}
				</dl>
			</section>
			if p.Can("monitors.write") {
				<div class="grid gap-6 md:grid-cols-2">
					<section class="card card-pad" aria-labelledby="export-title">
						<h2 id="export-title" class="text-lg font-semibold">Export</h2>
						<p class="subtitle mt-1 mb-4">Download monitors, groups, proxies, notification channels, maintenance windows and status pages as JSON.</p>
						<div class="flex flex-wrap items-center gap-2">
							<a href={ templ.SafeURL(p.BasePath + "/settings/export?redact_secrets=true") } class="btn-secondary">Export without secrets</a>
							<a href={ templ.SafeURL(p.BasePath + "/settings/export") } class="btn-secondary">Export with secrets</a>
						</div>
					</section>
					<section class="card card-pad" aria-labelledby="import-title">
						<h2 id="import-title" class="text-lg font-semibold">Import</h2>
						<p class="subtitle mt-1 mb-4">Restore or merge a previously exported file.</p>
						<form action={ templ.SafeURL(p.BasePath + "/settings/import") } method="POST" enctype="multipart/form-data" class="space-y-4"
							x-data="{ fileName: '', mode: 'merge' }"
							@submit="if (mode === 'replace' && !$el.dataset.confirmed) { $event.preventDefault(); $dispatch('confirm', { message: 'Replace mode deletes the current configuration before importing. Continue?', onConfirm: () => { $el.dataset.confirmed = '1'; $el.requestSubmit() } }) }">
							<div>
								<label class="form-label" for="import-mode">Mode</label>
								<select id="import-mode" name="mode" x-model="mode" class="form-select">
									<option value="merge">Merge: keep existing, skip duplicates</option>
									<option value="replace">Replace: overwrite everything</option>
								</select>
							</div>
							<div>
								<label class="form-label" for="import-file">File</label>
								<input id="import-file" type="file" name="file" accept=".json,application/json" required
									class="block w-full text-sm text-muted-light file:mr-3 file:h-8 file:px-3 file:rounded-control file:border file:border-line-light file:bg-surface-50 file:text-white file:text-sm file:font-medium hover:file:bg-surface-200 file:cursor-pointer"/>
							</div>
							<button type="submit" class="btn-primary">Import</button>
						</form>
					</section>
				</div>
				<section class="card card-pad" aria-labelledby="db-title">
					<h2 id="db-title" class="text-lg font-semibold">Database</h2>
					<p class="subtitle mt-1 mb-4">VACUUM reclaims space left by deleted rows and rebuilds the database file. Large databases can take a while.</p>
					<button type="button"
						data-url={ p.BasePath + "/settings/vacuum" }
						data-msg="Run VACUUM now? Writes pause until it finishes."
						@click="$dispatch('confirm',{url:$el.dataset.url,message:$el.dataset.msg})"
						class="btn-secondary">Run VACUUM</button>
				</section>
			}
		</div>
	}
}
