package views

import (
	"fmt"
	"net/url"
	"strconv"
	"strings"

	"github.com/y0f/asura/internal/storage"
)

type DashboardParams struct {
	LayoutParams
	Monitors      []*storage.Monitor
	Incidents     []*storage.Incident
	ResponseTimes map[int64]int64
	Sparklines    map[int64][]*storage.SparklinePoint
	Total         int
	Up            int
	Down          int
	Degraded      int
	Paused        int
	OpenIncidents int
	Page          int
	TotalPages    int
	Filter        string
}

func sparklineSVG(points []*storage.SparklinePoint) string {
	const (
		n      = 20
		barW   = 3
		barH   = 16
		gap    = 1
		totalW = n*(barW+gap) - gap
	)
	padded := make([]*storage.SparklinePoint, n)
	if len(points) >= n {
		copy(padded, points[len(points)-n:])
	} else {
		copy(padded[n-len(points):], points)
	}
	var sb strings.Builder
	sb.WriteString(fmt.Sprintf(`<svg width="%d" height="%d" viewBox="0 0 %d %d" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">`, totalW, barH, totalW, barH))
	for i, p := range padded {
		x := i * (barW + gap)
		color := "var(--color-chart-empty)"
		if p != nil {
			if tone := StatusTone(p.Status); tone != "neutral" {
				color = "var(--color-" + tone + ")"
			}
		}
		sb.WriteString(fmt.Sprintf(`<rect x="%d" y="0" width="%d" height="%d" rx="1" fill="%s"/>`, x, barW, barH, color))
	}
	sb.WriteString(`</svg>`)
	return sb.String()
}

func (p DashboardParams) pageHref(page int) string {
	q := url.Values{}
	q.Set("page", strconv.Itoa(page))
	if p.Filter != "" {
		q.Set("type", p.Filter)
	}
	return p.BasePath + "/?" + q.Encode()
}

func (p DashboardParams) summary() string {
	parts := []string{fmt.Sprintf("%d monitors", p.Total)}
	if p.Down > 0 {
		parts = append(parts, fmt.Sprintf("%d down", p.Down))
	}
	if p.Degraded > 0 {
		parts = append(parts, fmt.Sprintf("%d degraded", p.Degraded))
	}
	if p.Paused > 0 {
		parts = append(parts, fmt.Sprintf("%d paused", p.Paused))
	}
	if p.Total > 0 && p.Up == p.Total {
		parts = append(parts, "everything is up")
	}
	return strings.Join(parts, " · ")
}

func toneIf(cond bool, tone string) string {
	if cond {
		return tone
	}
	return "muted"
}

templ DashboardPage(p DashboardParams) {
	@Layout(p.LayoutParams) {
		@PageHeader(PageHeaderParams{Title: "Dashboard", Subtitle: p.summary()})
		<div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-8">
			@StatCard("Up", fmt.Sprint(p.Up), toneIf(p.Up > 0, "ok"))
			@StatCard("Down", fmt.Sprint(p.Down), toneIf(p.Down > 0, "crit"))
			@StatCard("Degraded", fmt.Sprint(p.Degraded), toneIf(p.Degraded > 0, "warn"))
			@StatCard("Open incidents", fmt.Sprint(p.OpenIncidents), toneIf(p.OpenIncidents > 0, "crit"))
		</div>
		<div class="grid grid-cols-1 xl:grid-cols-3 gap-8">
			<section class="xl:col-span-2 min-w-0" aria-labelledby="dash-monitors">
				<div class="flex items-center gap-3 mb-3">
					<h2 id="dash-monitors" class="text-xl font-bold">Monitors</h2>
					if p.Can("monitors.write") {
						<a href={ templ.SafeURL(p.BasePath + "/monitors/new") } class="btn-secondary btn-sm">+ Add</a>
					}
					<a href={ templ.SafeURL(p.BasePath + "/monitors") } class="ml-auto text-sm text-muted hover:text-white">View all</a>
				</div>
				<div id="monitor-grid"
					hx-get={ p.pageHref(p.Page) }
					hx-trigger="sse:refresh, every 30s" hx-select="#monitor-grid" hx-swap="outerHTML" hx-push-url="false"
					class="panel">
					if len(p.Monitors) > 0 {
						<ul class="divide-y divide-line">
							for _, m := range p.Monitors {
								<li>
									<a href={ templ.SafeURL(fmt.Sprintf("%s/monitors/%d", p.BasePath, m.ID)) }
										class="flex items-center justify-between gap-4 px-4 py-3 hover:bg-surface-200 group">
										<div class="min-w-0">
											<div class="text-sm font-medium text-white truncate">{ m.Name }</div>
											<div class="text-xs text-muted truncate">{ TypeLabel(m.Type) } · <span class="font-mono">{ m.Target }</span></div>
										</div>
										<div class="flex items-center gap-4 shrink-0">
											<span class="hidden sm:block w-14 text-right text-xs text-muted tabular-nums font-mono">
												if rt := p.ResponseTimes[m.ID]; rt > 0 {
													{ FormatMs(rt) }
												}
											</span>
											<span class="hidden md:flex w-[79px] justify-end items-center">
												if pts := p.Sparklines[m.ID]; len(pts) > 0 {
													@templ.Raw(sparklineSVG(pts))
												}
											</span>
											<span class="w-24 flex justify-end">
												@StatusPill(m.Status)
											</span>
										</div>
									</a>
								</li>
							}
						</ul>
					} else if p.Filter != "" {
						<div class="px-4 py-10 text-center text-sm text-muted">{ fmt.Sprintf("No %s monitors.", TypeLabel(p.Filter)) }</div>
					} else {
						<div class="px-4 py-10 text-center">
							<p class="text-sm text-muted-light">No monitors yet.</p>
							if p.Can("monitors.write") {
								<a href={ templ.SafeURL(p.BasePath + "/monitors/new") } class="btn-secondary mt-4">Create your first monitor</a>
							}
						</div>
					}
					if p.TotalPages > 1 {
						@Pager(p.Page, p.TotalPages, fmt.Sprintf("Page %d of %d", p.Page, p.TotalPages), p.pageHref(p.Page-1), p.pageHref(p.Page+1))
					}
				</div>
			</section>
			<section class="min-w-0" aria-labelledby="dash-incidents">
				<div class="flex items-center gap-3 mb-3">
					<h2 id="dash-incidents" class="text-xl font-bold">Open incidents</h2>
					<a href={ templ.SafeURL(p.BasePath + "/incidents") } class="ml-auto text-sm text-muted hover:text-white">View all</a>
				</div>
				<div class="panel">
					if len(p.Incidents) > 0 {
						<div class="divide-y divide-line">
							for _, inc := range p.Incidents {
								@IncidentRow(p.BasePath, inc)
							}
						</div>
					} else {
						<div class="px-4 py-10 text-center">
							<p class="text-sm text-muted-light">No open incidents.</p>
						</div>
					}
				</div>
			</section>
		</div>
		@MonitorListListener(p.BasePath, "monitor-grid")
	}
}
