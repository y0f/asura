package views

import (
	"fmt"
	"time"

	"github.com/y0f/asura/internal/storage"
)

type AgentListParams struct {
	LayoutParams
	Agents    []*storage.Agent
	ServerURL string
	// NewAgentName and NewAgentToken are set only on the response to a create,
	// so the token can be shown once and copied.
	NewAgentName  string
	NewAgentToken string
}

func agentOnline(a *storage.Agent) bool {
	return a.LastHeartbeat != nil && time.Since(*a.LastHeartbeat) < 2*time.Minute
}

func (p AgentListParams) runCommand(token string) string {
	return fmt.Sprintf("asura-agent --server %s --token %s", p.ServerURL, token)
}

templ AgentListPage(p AgentListParams) {
	@Layout(p.LayoutParams) {
		<div x-data="{showForm: false}">
			@PageHeader(PageHeaderParams{Title: "Agents", Subtitle: "Run checks from other locations and report back to this server."}) {
				if p.Can("monitors.write") {
					@ToolbarNewButtonClick("showForm = true", "New agent")
				}
			}
			if p.NewAgentToken != "" {
				<div class="card card-pad mb-6 border-brand" role="status" x-data={ fmt.Sprintf("{ copied: false, cmd: '%s' }", JSEscapeString(p.runCommand(p.NewAgentToken))) }>
					<h2 class="text-lg font-semibold">{ fmt.Sprintf("Agent \"%s\" created", p.NewAgentName) }</h2>
					<p class="subtitle mt-1 mb-3">Copy the token now. It is not shown again.</p>
					<div class="flex flex-col sm:flex-row gap-2">
						<code class="flex-1 min-w-0 px-3 py-2 rounded-control border border-line-light bg-surface text-xs font-mono text-white break-all">{ p.runCommand(p.NewAgentToken) }</code>
						<button type="button" class="btn-secondary shrink-0" @click="navigator.clipboard.writeText(cmd).then(() => copied = true)">
							<span x-text="copied ? 'Copied' : 'Copy command'">Copy command</span>
						</button>
					</div>
				</div>
			}
			if len(p.Agents) > 0 {
				<div class="panel overflow-x-auto">
					<table class="w-full min-w-[560px]">
						<thead>
							<tr class="border-b border-line">
								<th class="th">Name</th>
								<th class="th">Location</th>
								<th class="th">Status</th>
								<th class="th">Last seen</th>
								<th class="th w-px"><span class="sr-only">Actions</span></th>
							</tr>
						</thead>
						<tbody class="divide-y divide-line">
							for _, a := range p.Agents {
								<tr>
									<td class="px-4 py-3 text-sm text-white font-medium">{ a.Name }</td>
									<td class="px-4 py-3 text-sm text-muted-light">
										if a.Location != "" {
											{ a.Location }
										} else {
											<span class="text-muted">—</span>
										}
									</td>
									<td class="px-4 py-3">
										if agentOnline(a) {
											<span class="inline-flex items-center gap-1.5 text-sm text-ok"><span class="dot bg-ok"></span>Online</span>
										} else if a.LastHeartbeat != nil {
											<span class="inline-flex items-center gap-1.5 text-sm text-crit"><span class="dot bg-crit"></span>Offline</span>
										} else {
											<span class="inline-flex items-center gap-1.5 text-sm text-muted"><span class="dot bg-muted"></span>Never connected</span>
										}
									</td>
									<td class="px-4 py-3 text-sm text-muted">
										if a.LastHeartbeat != nil {
											@RelTime(*a.LastHeartbeat)
										} else {
											—
										}
									</td>
									<td class="px-4 py-3 text-right">
										if p.Can("monitors.write") {
											@DeleteButton(fmt.Sprintf("%s/agents/%d/delete", p.BasePath, a.ID), "Delete this agent? Monitors it was checking will fall back to checks from this server.")
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			} else {
				<div class="card px-6 py-10">
					<p class="text-sm text-muted-light">No agents yet.</p>
					<p class="text-sm text-muted mt-2">Create an agent, then run the agent binary on a remote host:</p>
					<pre class="mt-3 px-3 py-2 rounded-control border border-line-light bg-surface text-xs font-mono text-muted-light overflow-x-auto">{ p.runCommand("<agent-token>") }</pre>
					if p.Can("monitors.write") {
						<button type="button" @click="showForm = true" class="btn-secondary mt-4">Create your first agent</button>
					}
				</div>
			}
			@FormModal("showForm", "max-w-md", "'New agent'") {
				<form method="POST" action={ templ.SafeURL(p.BasePath + "/agents") } class="space-y-4">
					<div>
						<label class="form-label" for="agent-name">Name</label>
						<input id="agent-name" type="text" name="name" required placeholder="eu-west-1" class="form-input"/>
					</div>
					<div>
						<label class="form-label" for="agent-location">Location <span class="text-muted font-normal">(optional)</span></label>
						<input id="agent-location" type="text" name="location" placeholder="Frankfurt" class="form-input"/>
					</div>
					<div class="flex items-center gap-2 pt-1">
						<button type="submit" class="btn-primary">Create agent</button>
						<button type="button" @click="showForm = false" class="btn-secondary">Cancel</button>
					</div>
				</form>
			}
		</div>
	}
}
